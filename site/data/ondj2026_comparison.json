{"platform":{"target":"ONDJ","label":"ONDJ 2026/27","target_start":"2026-10-01","target_end":"2027-01-31","native_forecast":"outputs/final_shared_blend/init09_ONDJ/2026/forecast_2026.nc","native_sha256":"db0578a6365ebfd6f055a2efddd886d8a91c7675bbd05484119b189978cfe32c","minimum_leading_probability":0.4,"areas":{"all_ethiopia":"All Ethiopia","season_domain":"ONDJ R3 (Deyr) rainfall domain"}},"sources":[{"id":"icpac_ond_2026_update_rainfall","provider":"ICPAC","product":"rainfall_tercile_probability","representation":"dominant_category_map","label":"Rainfall forecast - October - December 2026_Update - IGAD Region","season_label":"OND 2026 (update)","target_start":"2026-10-01","target_end":"2026-12-31","issue_date":null,"initialization":null,"reference_period":null,"retrieved_utc":"2026-10-09T08:44:54+00:00","sha256":"38789cddd2e31c49b72ec97b821856d1d82d100e75971aef173b8f28d276afa6","page":"https://www.icpac.net/seasonal-forecast/october-december-2026_update/?region=1&resource_type=27","download":"https://www.icpac.net/media/images/GHA-PRCP.original.png","narrative":[{"text":"Above-normal rainfall is likely across most of the region, with the highest probabilities over north-eastern Kenya, central to southern Somalia and south-eastern Ethiopia.","locator":"detail page, rainfall forecast item"},{"text":"Across much of the remaining region, the probability of above-normal rainfall is generally in the range of 50–70%.","locator":"detail page, rainfall forecast item"}],"extraction":{"status":"needs_extraction_review","method":"automatic_raster_digitization","review":null},"figures":[{"id":"icpac_ond_2026_update_rainfall_map","file":"assets/external/ondj2026/icpac_ond_2026_update_rainfall.png","caption":"Rainfall forecast - October - December 2026_Update - IGAD Region"}]},{"id":"emi_bega_2026_27_outlook","provider":"EMI","product":"rainfall_tercile_probability","representation":"zone_tercile_probabilities","label":"Kiremt 2026 Assessment and Bega 2026_27 Outlook Hydro met Bulletin","season_label":"Bega (ONDJ) 2026/27","target_start":"2026-10-01","target_end":"2027-01-31","issue_date":null,"initialization":null,"reference_period":null,"retrieved_utc":"2026-10-09T08:45:10+00:00","sha256":"d55c4d39500d13a9da842a575f735bd07cf2ed08ac924ec8012e197a66e921a1","page":"https://www.ethiomet.gov.et/products/seasonal-hydromet-bulletin/kiremt-2026-assessment-and-bega-2026_27-hydro-met-bulletin/","download":"https://www.ethiomet.gov.et/documents/796/Kiremt_2026_Assesment_and_Bega_2026_27_Outlook_hydromet_Bulletin_pVHz8Fp.pdf","narrative":[{"text":"October: Humid to wet conditions across southern and southwestern catchments Baro-Akobo, Wabi Shebelle, Genale Dawa, Ogaden, and Abay support initial surface water accumulation.","locator":"PDF page 21"},{"text":"November: Moisture shifts southward; wet to very wet conditions continue in Genale Dawa, Wabi Shebelle, Baro- Akobo, Ogaden, and parts of Abay Rift Valley, while northern areas dry out.","locator":"PDF page 21"},{"text":"December: Dry to arid conditions dominate northern, central, and eastern basins Afar-Denakil, Aysha, middle upper Abay, Tekeze, and Awash. Sub-humid to wet levels persist in Omo-Gibe, Rift Valley, Baro-Akobo, Genale Dawa, Wabi Shebelle, and middle lower Ogaden.","locator":"PDF page 21"},{"text":"January: Arid conditions expand across most northern, central, and eastern catchments. Sub-humid to wet conditions remain confined to Omo-Gibe, Rift Valley, and upper Genale Dawa.","locator":"PDF page 21"}],"extraction":{"status":"needs_extraction_review","method":"draft_figure_transcription","review":null},"figures":[{"id":"emi_bega_2026_27_outlook_page21","file":"assets/external/ondj2026/emi_bega_2026_27_outlook_page21_figure.jpg","caption":"Kiremt 2026 Assessment and Bega 2026_27 Outlook Hydro met Bulletin, PDF page 21"}]}],"maps":[],"metrics":[{"metric":"display_official_probabilities","source_id":"emi_bega_2026_27_outlook","where":"III","status":"pending_review","reason":"transcriptio