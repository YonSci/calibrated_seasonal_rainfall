{
  "schema_version": 1,
  "name": "jan_fmam",
  "description": "Rainfall-amount bias-correction benchmark: January-initialized ECMWF SEAS5, FMAM season and its calendar months, every 0.25 deg cell of Ethiopia (docs/47).",
  "cycle": "config/cycles/jan_2026_fmam.json",
  "project_config": "config/fmam/project.json",
  "targets": [
    "Feb",
    "Mar",
    "Apr",
    "May",
    "FMAM"
  ],
  "training_years": [
    1993,
    2016
  ],
  "test_years": [
    2017,
    2025
  ],
  "all_years": [
    1993,
    2025
  ],
  "forecast_year": 2026,
  "cells": {
    "path": "data/masks/ethiopia_common.nc",
    "variable": "region_mask"
  },
  "regions": {
    "ethiopia": {
      "label": "All Ethiopia",
      "path": "data/masks/ethiopia_common.nc",
      "variable": "region_mask"
    },
    "fmam_domain": {
      "label": "FMAM rainfall contribution domain",
      "path": "data/masks/fmam_coverage_chirps_v3_1993_2025_v1.nc",
      "variable": "season_domain"
    }
  },
  "primary_region": "ethiopia",
  "reference_method": "mvs",
  "smoothing_alpha": 0.5,
  "dry_threshold_mm": 1.0,
  "pit_bins": 10,
  "methods": {
    "raw": {},
    "ls": {
      "min_model_mean": 0.1
    },
    "mvs": {
      "ratio_bounds": [
        0.5,
        2.0
      ],
      "min_model_sd": 1.0
    },
    "vs": {
      "ratio_bounds": null,
      "min_model_sd": 1.0
    },
    "sqrt_mvs": {
      "ratio_bounds": [
        0.5,
        2.0
      ],
      "min_model_sd": 0.1,
      "space": "sqrt"
    },
    "pt": {
      "b_bounds": [
        0.1,
        3.0
      ]
    },
    "dc": {
      "ratio_bounds": [
        0.2,
        5.0
      ],
      "min_model_mean": 0.1
    },
    "loci": {
      "wet_threshold": 1.0
    },
    "eqm": {
      "extrapolation": "constant_ratio",
      "wet_threshold": 1.0
    },
    "gqm": {
      "wet_threshold": 1.0
    },
    "dqm": {
      "extrapolation": "constant_ratio",
      "ratio_bounds": [
        0.2,
        5.0
      ],
      "min_model_mean": 0.1,
      "wet_threshold": 1.0
    },
    "qdm": {
      "max_ratio": 5.0,
      "wet_threshold": 1.0
    },
    "sdm": {
      "wet_threshold": 1.0
    },
    "cdft": {
      "min_model_mean": 0.1
    },
    "mvs_zero_guard": {
      "ratio_bounds": [
        0.5,
        2.0
      ],
      "min_model_sd": 1.0,
      "zero_guard": true
    }
  },
  "example_cell_quantiles": [
    0.1,
    0.5,
    0.9
  ],
  "confirmation": {
    "methods": [
      "mvs",
      "ls",
      "vs",
      "sqrt_mvs",
      "pt",
      "dc",
      "loci",
      "eqm",
      "gqm",
      "dqm",
      "qdm",
      "sdm",
      "cdft"
    ],
    "variants": [
      "mvs_zero_guard"
    ],
    "selection_region": "ethiopia",
    "reliability_bins": 10,
    "reliability_methods": [
      "mvs",
      "sqrt_mvs",
      "gqm",
      "eqm"
    ],
    "output_root": "outputs/bias_correction_benchmark/jan_fmam/confirmation"
  },
  "output_root": "outputs/bias_correction_benchmark/jan_fmam"
}
