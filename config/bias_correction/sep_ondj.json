{
  "schema_version": 1,
  "name": "sep_ondj",
  "description": "Rainfall-amount bias-correction benchmark: September-initialized ECMWF SEAS5, ONDJ season and its calendar months, every 0.25 deg cell of Ethiopia (docs/47).",
  "cycle": "config/cycles/sep_2026_ondj.json",
  "project_config": "config/ondj/project.json",
  "targets": ["Oct", "Nov", "Dec", "Jan", "ONDJ"],
  "training_years": [1993, 2016],
  "test_years": [2017, 2024],
  "all_years": [1993, 2024],
  "forecast_year": 2026,
  "cells": {"path": "data/masks/ethiopia_common.nc", "variable": "region_mask"},
  "regions": {
    "ethiopia": {"label": "All Ethiopia", "path": "data/masks/ethiopia_common.nc", "variable": "region_mask"},
    "ondj_domain": {"label": "ONDJ R3 (Deyr) domain", "path": "data/masks/init09_ONDJ_regime_domain.nc", "variable": "season_domain"}
  },
  "primary_region": "ethiopia",
  "reference_method": "mvs",
  "smoothing_alpha": 0.5,
  "dry_threshold_mm": 1.0,
  "pit_bins": 10,
  "methods": {
    "raw": {},
    "ls": {"min_model_mean": 0.1},
    "mvs": {"ratio_bounds": [0.5, 2.0], "min_model_sd": 1.0},
    "vs": {"ratio_bounds": null, "min_model_sd": 1.0},
    "sqrt_mvs": {"ratio_bounds": [0.5, 2.0], "min_model_sd": 0.1, "space": "sqrt"},
    "pt": {"b_bounds": [0.1, 3.0]},
    "dc": {"ratio_bounds": [0.2, 5.0], "min_model_mean": 0.1},
    "loci": {"wet_threshold": 1.0},
    "eqm": {"extrapolation": "constant_ratio", "wet_threshold": 1.0},
    "gqm": {"wet_threshold": 1.0},
    "dqm": {"extrapolation": "constant_ratio", "ratio_bounds": [0.2, 5.0], "min_model_mean": 0.1, "wet_threshold": 1.0},
    "qdm": {"max_ratio": 5.0, "wet_threshold": 1.0},
    "sdm": {"wet_threshold": 1.0},
    "cdft": {"min_model_mean": 0.1},
    "mvs_zero_guard": {"ratio_bounds": [0.5, 2.0], "min_model_sd": 1.0, "zero_guard": true}
  },
  "example_cell_quantiles": [0.1, 0.5, 0.9],
  "confirmation": {
    "methods": ["mvs", "ls", "vs", "sqrt_mvs", "pt", "dc", "loci", "eqm", "gqm", "dqm", "qdm", "sdm", "cdft"],
    "variants": ["mvs_zero_guard"],
    "selection_region": "ethiopia",
    "reliability_bins": 10,
    "reliability_methods": ["mvs", "sqrt_mvs", "gqm", "eqm"],
    "output_root": "outputs/bias_correction_benchmark/sep_ondj/confirmation"
  },
  "output_root": "outputs/bias_correction_benchmark/sep_ondj"
}
