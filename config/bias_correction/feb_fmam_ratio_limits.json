{
  "schema_version": 1,
  "name": "feb_fmam_ratio_limits",
  "description": "MVS ratio-limit study: February-initialized ECMWF SEAS5, FMAM season and its calendar months, every 0.25 deg cell of Ethiopia (docs/47). Operational MVS (spread ratio limited to 0.5-2) against the same correction with limits 1/3-3, 1/4-4 and none.",
  "cycle": "config/cycles/feb_2026_fmam.json",
  "project_config": "config/fmam_feb/project.json",
  "targets": [
    "Feb",
    "Mar",
    "Apr",
    "May",
    "FMAM"
  ],
  "training_years": [
    1993,
    2016
  ],
  "test_years": [
    2017,
    2025
  ],
  "all_years": [
    1993,
    2025
  ],
  "forecast_year": 2026,
  "cells": {
    "path": "data/masks/ethiopia_common.nc",
    "variable": "region_mask"
  },
  "regions": {
    "ethiopia": {
      "label": "All Ethiopia",
      "path": "data/masks/ethiopia_common.nc",
      "variable": "region_mask"
    },
    "fmam_domain": {
      "label": "FMAM rainfall contribution domain",
      "path": "data/masks/fmam_coverage_chirps_v3_1993_2025_v1.nc",
      "variable": "season_domain"
    }
  },
  "primary_region": "ethiopia",
  "reference_method": "mvs",
  "smoothing_alpha": 0.5,
  "dry_threshold_mm": 1.0,
  "pit_bins": 10,
  "methods": {
    "mvs": {
      "ratio_bounds": [
        0.5,
        2.0
      ],
      "min_model_sd": 1.0
    },
    "mvs_r3": {
      "base": "mvs",
      "label": "MVS, ratio limits 1/3-3",
      "family": "scaling",
      "ratio_bounds": [
        0.3333333333333333,
        3.0
      ],
      "min_model_sd": 1.0
    },
    "mvs_r4": {
      "base": "mvs",
      "label": "MVS, ratio limits 1/4-4",
      "family": "scaling",
      "ratio_bounds": [
        0.25,
        4.0
      ],
      "min_model_sd": 1.0
    },
    "vs": {
      "ratio_bounds": null,
      "min_model_sd": 1.0
    }
  },
  "example_cell_quantiles": [
    0.1,
    0.5,
    0.9
  ],
  "confirmation": {
    "methods": [
      "mvs",
      "mvs_r3",
      "mvs_r4",
      "vs"
    ],
    "variants": [],
    "selection_region": "ethiopia",
    "reliability_bins": 10,
    "reliability_methods": [
      "mvs",
      "mvs_r3",
      "mvs_r4",
      "vs"
    ],
    "output_root": "outputs/bias_correction_benchmark/feb_fmam/ratio_limits/confirmation"
  },
  "output_root": "outputs/bias_correction_benchmark/feb_fmam/ratio_limits"
}
