  "candidate_cleanup": "none",
  "comparators": [
    {
      "id": "r3_regime_rule",
      "kind": "mask_file",
      "path": "data/masks/init09_ONDJ_regime_domain.nc",
      "label": "Current ONDJ R3 (Deyr) rainfall domain: R3 membership, ONDJ >= 30 mm, patches < 3 cells removed",
      "reference_note": "Regime membership is not an amount/share threshold."
    },
    {
      "id": "earlier_mm120_share20",
      "kind": "mask_file",
      "path": "data/masks/init09_ONDJ_rainfall_domain.nc",
      "label": "Earlier ONDJ rainfall domain (not in use): ONDJ >= 120 mm and >= 20% of annual (1993-2024)"
    },
    {
      "id": "share40_mm60",
      "kind": "rule",
      "rule": "share",
      "annual_share_percent": 40,
      "seasonal_rainfall_mm": 60,
      "label": "40% contribution rule: ONDJ >= 40% of annual and >= 60 mm (no cleanup)"
    },
    {
      "id": "wettest_mm60",
      "kind": "rule",
      "rule": "wettest",
      "seasonal_rainfall_mm": 60,
      "label": "Wettest-season rule: ONDJ wetter than FMAM and JJAS, >= 60 mm (no cleanup)"
    }
