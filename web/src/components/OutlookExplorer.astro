---
// Interactive outlook map and area search: every 0.25-degree cell of the forecast, hover for its values, click or search a
// region, zone or woreda for a plain-language summary (lib/plain.js). Data: site/data/cells/<cycle>/ and site/data/areas.json
// (scripts/site_cells.py), fetched in the browser; without JavaScript the static maps below remain.
import { asset } from '../lib/data.js';
const { cycle, view, target, label, viewLabel, reference } = Astro.props;
---
<section id="explore" class="explore"
         data-grid={asset(`data/cells/${cycle}/grid.json`)} data-cells={asset(`data/cells/${cycle}/${target}.json`)}
         data-areas={asset('data/areas.json')} data-view={view} data-label={label} data-view-label={viewLabel} data-reference={reference}>
  <h2>Explore the map</h2>
  <p class="caveat">Hover over the map for the values of each grid cell, click a place or search for a region, zone or woreda for its outlook in
  words. Zoom with the + and − buttons (or Ctrl + wheel), drag to move when zoomed in. With the keyboard: Tab to the map, then the arrow keys
  move between cells, Enter selects the woreda, + and − zoom, 0 resets.</p>
  <div class="ex-controls">
    <label class="ex-search">Find a place
      <input id="ex-search" list="ex-areas" type="search" placeholder="Region, zone or woreda (e.g. Borena)" autocomplete="off" />
    </label>
    <datalist id="ex-areas"></datalist>
    <label class="check"><input type="checkbox" id="ex-cb" /> Colour-blind friendly colours</label>
  </div>
  <div class="seg ex-layers" role="group" aria-label="Map layer" id="ex-layer">
    <button type="button" data-layer="tercile" aria-pressed="true">Most likely outcome</button>
    <button type="button" data-layer="above" aria-pressed="false">Chance of above normal</button>
    <button type="button" data-layer="below" aria-pressed="false">Chance of below normal</button>
    <button type="button" data-layer="mean" aria-pressed="false">Expected rainfall</button>
    <button type="button" data-layer="anomaly" aria-pressed="false">Difference from normal</button>
    <button type="button" data-layer="skill" aria-pressed="false">Track record</button>
  </div>
  <div class="ex-body">
    <div class="ex-mapwrap">
      <canvas id="ex-map" tabindex="0" role="img" aria-label={`Interactive map of the ${label} outlook. Arrow keys move between cells, Enter selects the woreda.`} aria-describedby="ex-desc"></canvas>
      <div class="ex-zoom"><button type="button" data-zoom="in" aria-label="Zoom in">+</button><button type="button" data-zoom="out" aria-label="Zoom out">−</button><button type="button" data-zoom="reset" aria-label="Reset the view">⟲</button></div>
      <div id="ex-tip" class="ex-tip" hidden></div>
      <div id="ex-legend" class="ex-legend"></div>
      <p id="ex-desc" class="ex-desc caveat" aria-live="polite"></p>
      <p id="ex-status" class="caveat" role="status">Loading the map…</p>
    </div>
    <aside id="ex-panel" class="box ex-panel" aria-live="polite">
      <h3>Your area</h3>
      <p class="caveat">Click the map or search for a place to see its outlook in words.</p>
    </aside>
  </div>
  <noscript><p class="notice">The interactive map needs JavaScript; the maps below show the same forecast.</p></noscript>
  <p class="caveat ex-source">Grid: 0.25° (about 28 km); the model's own resolution is about 1°. Boundaries: OCHA Common Operational Datasets (COD-AB,
  2025), CC BY-IGO; shown for orientation only. Areas are matched to the grid cells whose centres fall inside them; a woreda smaller than a cell takes the
  cell at its centre.</p>
</section>

<script>
  import * as P from '../lib/plain.js';
  import { t, langFromQuery, REVIEWED } from '../lib/i18n.js';
  import { RAMPS, SEQ, RAIN, DIV, SKILL, DRY, OUT, bin, tercileColor, anomalyColor, createMap } from '../lib/cellmap.js';
  const L = langFromQuery(location.search);          // drafts (am, om) only with ?lang=; English is authoritative

  const root = document.getElementById('explore') as HTMLElement;
  const ASKED = new URLSearchParams(location.search).get('area');      // read at once: other scripts may rewrite the query
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const pc = (x: number) => `${Math.round(100 * x)}%`;
  const mm = (x: number) => `${Math.round(x)} mm`;

  const S: any = { layer: 'tercile', palette: 'standard', sel: null };
  let G: any, D: any, A: any, M: any, byCell: Map<number, any>, inView: Set<number>;
  const canvas = $('ex-map') as HTMLCanvasElement;
  function color(i: number): string {
    if (!inView.has(i)) return OUT;
    const pb = D.pb[i], pn = D.pn[i], pa = D.pa[i];
    if (S.layer === 'tercile' || S.layer === 'above' || S.layer === 'below') {
      if (pb == null) return DRY;
      if (S.layer !== 'tercile') {
        const v = 100 * (S.layer === 'above' ? pa : pb);
        const ramp = S.layer === 'above' ? (S.palette === 'cb' ? RAMPS.cb[2] : SEQ.standard) : RAMPS[S.palette][0];
        return ramp[Math.min(ramp.length - 1, Math.max(0, Math.floor((v - 10) / 10)))];
      }
      return tercileColor([pb, pn, pa], S.palette);
    }
    if (S.layer === 'mean') {
      const v = D.mean[i]; if (v == null) return DRY;
      return RAIN[bin(v, S.rainEdges)];
    }
    if (S.layer === 'anomaly') return anomalyColor(D.mean[i], D.normal[i]);
    const rb = D.rb_tr?.[i], rc = D.rc_tr?.[i]; if (rb == null || !(rc > 0)) return DRY;
    const r = 1 - (D.n_tr * rb / rc + (D.rb_op?.[i] != null && D.rc_op[i] > 0 ? D.n_op * D.rb_op[i] / D.rc_op[i] : D.n_op * rb / rc)) / (D.n_tr + D.n_op);
    return SKILL[bin(r, [-1e9, -0.1, -0.05, 0, 0.05, 0.1, 0.2, 0.3, 1e9])];
  }
  const LEGENDS: Record<string, () => string> = {
    tercile: () => ['Below normal', 'Near normal', 'Above normal'].map((n, k) => `<span class="lg-row"><b>${n}</b>${RAMPS[S.palette][k].map((c) => `<i style="background:${c}"></i>`).join('')}</span>`).join('') +
      `<span class="lg-row caveat">40% → 100% chance of the most likely category; white: no category reaches 40%</span>`,
    above: () => `<span class="lg-row"><b>Chance of above normal</b>${(S.palette === 'cb' ? RAMPS.cb[2] : SEQ.standard).map((c) => `<i style="background:${c}"></i>`).join('')}</span><span class="lg-row caveat">10% → 70%+ (33% is the normal chance)</span>`,
    below: () => `<span class="lg-row"><b>Chance of below normal</b>${RAMPS[S.palette][0].map((c) => `<i style="background:${c}"></i>`).join('')}</span><span class="lg-row caveat">10% → 70%+ (33% is the normal chance)</span>`,
    mean: () => `<span class="lg-row"><b>Expected rainfall</b>${RAIN.map((c) => `<i style="background:${c}"></i>`).join('')}</span><span class="lg-row caveat">${S.rainEdges.slice(1, -1).map((e: number) => Math.round(e)).join(' · ')} mm</span>`,
    anomaly: () => `<span class="lg-row"><b>Difference from normal</b>${DIV.map((c) => `<i style="background:${c}"></i>`).join('')}</span><span class="lg-row caveat">−60% · −40% · −20% · ±5% · +20% · +40% · +60%</span>`,
    skill: () => `<span class="lg-row"><b>Track record (skill)</b>${SKILL.map((c) => `<i style="background:${c}"></i>`).join('')}</span><span class="lg-row caveat">worse than climatology ← 0 → better (RPSS −0.1 … +0.3); single cells are noisy</span>`,
  };

  // ---------------------------------------------------------------- drawing (lib/cellmap.js)
  function draw() {
    M.draw(color, { sel: S.sel ? S.sel.pos : null, cursor: S.kb ?? -1 });
    $('ex-legend').innerHTML = LEGENDS[S.layer]();
    if (S.described !== S.layer) { $('ex-desc').textContent = describe(); S.described = S.layer; }
  }
  // The map in words (screen readers and everyone): what the chosen layer shows over the selected area, cos(latitude)-weighted.
  function describe() {
    const w = G._w ?? (G._w = P.weights(G)), pos = [...inView];
    const share = (f: (i: number) => boolean | null) => { let a = 0, b = 0; for (const i of pos) { const v = f(i); if (v === null) continue; b += w[i]; if (v) a += w[i]; } return b ? a / b : null; };
    const s = P.stats(G, D, pos), where = root.dataset.viewLabel;
    if (S.layer === 'tercile') {
      if (!s.share) return `In words: no tercile forecast over the ${where} (dry season).`;
      const parts = (['above', 'below', 'near'] as const).filter((k) => s.share[k] >= 0.005).sort((a, b) => s.share[b] - s.share[a])
        .map((k) => `${k} normal over ${pc(s.share[k])}`);
      return `In words: the most likely outcome (40% chance or more) is ${parts.length ? parts.join(', ') : 'none'} of the ${where}` + (s.share.none >= 0.005 ? `; no category reaches 40% over ${pc(s.share.none)}.` : '.');
    }
    if (S.layer === 'above' || S.layer === 'below') {
      const k = S.layer === 'above' ? 2 : 0, arr = S.layer === 'above' ? D.pa : D.pb;
      const hi = share((i) => (arr[i] == null ? null : arr[i] >= 0.5));
      return s.p ? `In words: the chance of ${S.layer} normal averages ${pc(s.p[k])} over the ${where} (33% is the normal chance); it is 50% or more over ${pc(hi ?? 0)} of the area.` : 'In words: no tercile forecast here.';
    }
    if (S.layer === 'mean') return s.mean != null ? `In words: expected rainfall averages ${mm(s.mean)} over the ${where}, against a normal of ${mm(s.normal)}.` : '';
    if (S.layer === 'anomaly') {
      const wet = share((i) => (D.mean[i] == null || !(D.normal[i] > 0) ? null : D.mean[i] > 1.05 * D.normal[i]));
      const dry = share((i) => (D.mean[i] == null || !(D.normal[i] > 0) ? null : D.mean[i] < 0.95 * D.normal[i]));
      return s.anomaly != null ? `In words: expected rainfall is ${pc(Math.abs(s.anomaly))} ${s.anomaly >= 0 ? 'above' : 'below'} normal on average over the ${where}; more than 5% wetter than normal over ${pc(wet ?? 0)} of the area and more than 5% drier over ${pc(dry ?? 0)}.` : '';
    }
    const better = share((i) => {
      const rb = D.rb_tr?.[i], rc = D.rc_tr?.[i];
      return rb == null || !(rc > 0) ? null : rb < rc;
    });
    const tr = P.track(s.rpss, L);
    return `In words: over past years, forecasts made this way scored better than climatology over ${pc(better ?? 0)} of the ${where} (1993–2016, cross-validated); overall track record: ${tr.word}.`;
  }

  // ---------------------------------------------------------------- interaction
  const cellAt = (ev: MouseEvent) => M.cellAt(ev.clientX, ev.clientY);
  function tip(ev: MouseEvent) {
    const rect = canvas.parentElement!.getBoundingClientRect();
    tipAt(cellAt(ev), ev.clientX - rect.left, ev.clientY - rect.top);
  }
  function tipAt(i: number, x: number, y: number) {
    const t = $('ex-tip');
    if (i < 0) { t.hidden = true; return; }
    const c = G.cells[i], [la, lo] = M.latlon(i);
    const w = byCell.get(c);
    const s = P.stats(G, D, [i]);
    const where = w ? `${esc(w.name)}, ${esc(w.zone)} (${esc(w.region)})` : `${la.toFixed(2)}°N ${lo.toFixed(2)}°E`;
    t.innerHTML = `<strong>${where}</strong><br>` + (s.p ? `Below ${pc(s.p[0])} · near ${pc(s.p[1])} · above ${pc(s.p[2])}` : 'Dry season: no tercile forecast') +
      (s.mean != null ? `<br>Expected ${mm(s.mean)} (normal ${mm(s.normal)})` : '') + (inView.has(i) ? '' : '<br><em>outside the selected domain</em>');
    const rect = canvas.parentElement!.getBoundingClientRect();
    t.style.left = Math.max(4, Math.min(x + 14, rect.width - 230)) + 'px';
    t.style.top = y + 14 + 'px';
    t.hidden = false;
  }
  function select(area: any, push = true) {
    S.sel = { area, pos: P.positions(G, area.cells) };
    const s = P.stats(G, D, S.sel.pos);
    const parents = [area.zone, area.region].filter(Boolean);
    const level = t(L, A.levels[String(area.level)]);
    const up = area.level === 3 ? A.areas.filter((x: any) => (x.level === 2 && x.name === area.zone && x.region === area.region) || (x.level === 1 && x.name === area.region))
      : area.level === 2 ? A.areas.filter((x: any) => x.level === 1 && x.name === area.region) : [];
    const t10 = s.p ? P.tenths(s.p) : null;
    const tr = P.track(s.rpss, L);
    const cats = ['below', 'near', 'above'];
    $('ex-panel').innerHTML = (L !== 'en' && !REVIEWED[L] ? `<p class="caveat plain-draft">${esc(t(L, 'draft'))}</p>` : '') +
      `<h3>${esc(area.name)}</h3><p class="caveat">${esc(level)}${parents.length ? ' · ' + parents.map(esc).join(', ') : ''} · ${s.cells} ${t(L, s.cells === 1 ? 'gridCell' : 'gridCells')}</p>` +
      (s.p ? `<div class="probbar" role="img" aria-label="Chances: below ${pc(s.p[0])}, near ${pc(s.p[1])}, above ${pc(s.p[2])}">${cats.map((c, k) => `<span class="pb-${c}" style="flex:${s.p[k]}">${pc(s.p[k])}</span>`).join('')}</div>
        <p class="tenths" aria-hidden="true">${t10!.map((n: number, k: number) => `<span class="t-${cats[k]}">${'●'.repeat(n)}</span>`).join('')}</p>
        <p class="caveat">${esc(t(L, 'tenths', { b: t10![0], n: t10![1], a: t10![2] }))}</p>` : '') +
      `<p>${esc(P.describe(s, area.name, root.dataset.label, L))}</p>` +
      `<dl class="ex-facts">` + (s.mean != null ? `<dt>${t(L, 'expectedRainfall')}</dt><dd>${mm(s.mean)} (${t(L, 'normal')} ${mm(s.normal)}, ${root.dataset.reference})</dd>` : '') +
      (s.observed != null ? `<dt>${t(L, 'observed')}</dt><dd>${mm(s.observed)} (CHIRPS)</dd>` : '') +
      `<dt>${t(L, 'trackHere')}</dt><dd><span class="tr tr-${tr.level}">${esc(tr.word)}</span>${s.rpss != null ? ` <span class="caveat">(${t(L, 'skillScore')} ${s.rpss >= 0 ? '+' : ''}${s.rpss.toFixed(2)}, ${s.years} ${t(L, 'pastSeasons')})</span>` : ''}</dd></dl>` +
      (area.level === 3 && s.cells === 1 ? `<p class="caveat">${esc(t(L, 'smallWoreda'))}</p>` : '') +
      (up.length ? `<p class="ex-up">${up.sort((a: any, b: any) => b.level - a.level).map((u: any) => `<button type="button" class="linkbtn" data-area="${u.id}">${esc(u.name)} (${esc(t(L, A.levels[String(u.level)]).toLowerCase())})</button>`).join(' · ')}</p>` : '') +
      `<p><button type="button" class="linkbtn" id="ex-csv">${esc(t(L, 'csv'))}</button> · <button type="button" class="linkbtn" id="ex-share">${esc(t(L, 'copy'))}</button></p>`;
    if (push) {
      const q = new URLSearchParams(location.search); q.set('area', area.id);
      history.replaceState(null, '', location.pathname + '?' + q + location.hash);
    }
    draw();
  }
  function csv() {
    const rows = [['lat', 'lon', 'p_below', 'p_near', 'p_above', 'expected_mm', 'normal_mm', 'members_q10_mm', 'members_q90_mm']];
    for (const i of S.sel.pos) {
      const c = G.cells[i];
      rows.push([(G.lat0 + G.dlat * Math.floor(c / G.nlon)).toFixed(3), (G.lon0 + G.dlon * (c % G.nlon)).toFixed(3),
        D.pb[i], D.pn[i], D.pa[i], D.mean[i], D.normal[i], D.q10[i], D.q90[i]].map((v) => (v == null ? '' : String(v))));
    }
    const blob = new Blob([rows.map((r) => r.join(',')).join('\n') + '\n'], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = `${S.sel.area.id}_${S.sel.area.name.replace(/\W+/g, '_')}_${root.dataset.label!.replace(/\W+/g, '_')}.csv`;
    a.click(); URL.revokeObjectURL(a.href);
  }

  async function start() {
    try {
      [G, D, A] = await Promise.all([root.dataset.grid, root.dataset.cells, root.dataset.areas].map((u) => fetch(u!).then((r) => { if (!r.ok) throw new Error(u); return r.json(); })));
    } catch (err) { $('ex-status').textContent = 'The interactive map could not be loaded; the maps below show the same forecast.'; return; }
    P.positions(G, []);
    M = createMap(canvas, G, A);
    inView = new Set(G.views[root.dataset.view!] ?? G.views.all_ethiopia);
    byCell = new Map();
    A.areas.filter((a: any) => a.level === 3).forEach((a: any) => a.cells.forEach((c: number) => { if (!byCell.has(c)) byCell.set(c, a); }));
    const vals = D.mean.filter((v: any) => v != null).sort((a: number, b: number) => a - b);
    const q = (f: number) => vals[Math.floor(f * (vals.length - 1))] ?? 0;
    const nice = (v: number) => { const p = Math.pow(10, Math.floor(Math.log10(Math.max(v, 1)))); return Math.round(v / p) * p; };
    S.rainEdges = [-1e9, ...[.1, .25, .4, .55, .7, .85, .95].map((f) => nice(q(f))), 1e9];
    try { S.palette = localStorage.getItem('mapPalette') === 'cb' ? 'cb' : 'standard'; } catch { /* storage unavailable */ }
    ($('ex-cb') as HTMLInputElement).checked = S.palette === 'cb';
    const dl = $('ex-areas');
    dl.innerHTML = A.areas.map((a: any) => `<option value="${esc(a.name)}${a.level > 1 ? ' — ' + esc(a.level === 3 ? a.zone + ', ' + a.region : a.region) : ''}">${esc(A.levels[String(a.level)])}</option>`).join('');
    $('ex-status').textContent = '';
    draw();
    if (L !== 'en') {                                               // the hero summary translates itself (OutlookHero)
      $('ex-panel').querySelector('h3')!.textContent = t(L, 'yourArea');
      ($('ex-panel').querySelector('.caveat') as HTMLElement).textContent = t(L, 'clickHint');
    }
    const first = ASKED && A.areas.find((a: any) => a.id === ASKED);
    if (first) select(first, false);
  }

  root.addEventListener('click', (ev) => {
    const el = ev.target as HTMLElement;
    const b = el.closest('[data-layer]') as HTMLElement | null;
    if (b) { S.layer = b.dataset.layer; root.querySelectorAll('[data-layer]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw(); return; }
    const z = el.closest('[data-zoom]') as HTMLElement | null;
    if (z && M) {
      if (z.dataset.zoom === 'reset') M.reset(); else M.zoom(z.dataset.zoom === 'in' ? 1.5 : 1 / 1.5);
      draw(); return;
    }
    const up = el.closest('[data-area]') as HTMLElement | null;
    if (up) { const a = A.areas.find((x: any) => x.id === up.dataset.area); if (a) select(a); return; }
    if (el.id === 'ex-csv') { csv(); return; }
    if (el.id === 'ex-share') { navigator.clipboard?.writeText(location.href); el.textContent = t(L, 'copied'); return; }
  });
  let drag: any = null, moved = false;
  // pointer events (mouse, pen, touch): drag moves the map only when zoomed in, so the page still scrolls over it otherwise
  canvas.addEventListener('pointerdown', (ev) => { moved = false; if (M && M.view.scale > 1) { drag = { x: ev.clientX, y: ev.clientY, ox: M.view.ox, oy: M.view.oy }; canvas.setPointerCapture(ev.pointerId); } });
  canvas.addEventListener('pointerup', () => { drag = null; });
  canvas.addEventListener('pointercancel', () => { drag = null; });
  canvas.addEventListener('pointermove', (ev) => {
    if (drag) { const dx = ev.clientX - drag.x, dy = ev.clientY - drag.y; if (Math.abs(dx) + Math.abs(dy) > 3) moved = true; M.view.ox = drag.ox + dx; M.view.oy = drag.oy + dy; draw(); }
    if (G && ev.pointerType === 'mouse') tip(ev);
  });
  canvas.addEventListener('pointerleave', () => { if (S.kb == null || S.kb < 0) $('ex-tip').hidden = true; });
  // keyboard: arrows move a cell cursor (shift: 4 cells), Enter / Space selects its woreda, + / − zoom, 0 resets, Escape leaves the cursor
  canvas.addEventListener('keydown', (ev) => {
    if (!M) return;
    const moves: Record<string, [number, number]> = { ArrowUp: [1, 0], ArrowDown: [-1, 0], ArrowLeft: [0, -1], ArrowRight: [0, 1] };
    if (moves[ev.key]) {
      ev.preventDefault();
      if (S.kb == null || S.kb < 0) S.kb = S.sel?.pos?.[0] ?? [...inView][Math.floor(inView.size / 2)] ?? 0;
      else for (let n = 0; n < (ev.shiftKey ? 4 : 1); n++) S.kb = M.step(S.kb, ...moves[ev.key]);
      M.reveal(S.kb);
    } else if ((ev.key === 'Enter' || ev.key === ' ') && S.kb >= 0) {
      ev.preventDefault();
      const w = byCell.get(G.cells[S.kb]); if (w) select(w);
    } else if (ev.key === '+' || ev.key === '=') { M.zoom(1.5); if (S.kb >= 0) M.reveal(S.kb); }
    else if (ev.key === '-' || ev.key === '_') M.zoom(1 / 1.5);
    else if (ev.key === '0') M.reset();
    else if (ev.key === 'Escape') { S.kb = -1; $('ex-tip').hidden = true; draw(); return; }
    else return;
    draw();
    if (S.kb >= 0) { const b = M.cellBox(S.kb); tipAt(S.kb, b.x + b.w, b.y + b.h); }
  });
  canvas.addEventListener('blur', () => { $('ex-tip').hidden = true; });
  canvas.addEventListener('click', (ev) => {
    if (moved || !G) return;
    const i = cellAt(ev); if (i < 0) return;
    const w = byCell.get(G.cells[i]); if (w) select(w);
  });
  canvas.addEventListener('wheel', (ev) => {
    if (!G || !(ev.ctrlKey || ev.metaKey)) return;              // plain wheel scrolls the page
    ev.preventDefault();
    const rect = canvas.getBoundingClientRect();
    M.zoom(ev.deltaY < 0 ? 1.2 : 1 / 1.2, ev.clientX - rect.left, ev.clientY - rect.top);
    draw();
  }, { passive: false });
  $('ex-cb').addEventListener('change', (ev) => {
    S.palette = (ev.target as HTMLInputElement).checked ? 'cb' : 'standard';
    try { localStorage.setItem('mapPalette', S.palette); } catch { /* storage unavailable */ }
    draw();
  });
  $('ex-search').addEventListener('change', (ev) => {
    const v = (ev.target as HTMLInputElement).value.trim().toLowerCase();
    if (!A || !v) return;
    const name = v.split(' — ')[0];
    const rest = v.includes(' — ') ? v.split(' — ')[1] : '';
    const hit = A.areas.find((a: any) => a.name.toLowerCase() === name && (!rest || rest.includes((a.region ?? '').toLowerCase())))
      ?? A.areas.find((a: any) => a.name.toLowerCase().startsWith(name));
    if (hit) select(hit);
  });
