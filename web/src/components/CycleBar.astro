---
// Cycle, area and section switch for the outlook pages (links, so every state has its own address).
import { C, url, defaultTarget } from '../lib/cycles.js';
const { cycle, view, section, target = null } = Astro.props;   // section: 'outlook' | 'verification' | 'history'
const keep = (c, v) => (section === 'outlook' ? url.target(c, v, c.targets.some((t) => t.id === target) ? target : defaultTarget(c))
  : section === 'verification' ? url.verification(c, v) : url.history(c, v));
const viewFor = (c) => (c.views.some((v) => v[0] === view) ? view : c.default_view);
const tabs = [['outlook', 'Outlook and maps', url.target(cycle, view, target ?? defaultTarget(cycle))], ['verification', 'Verification', url.verification(cycle, view)],
  ['history', 'Historical performance', url.history(cycle, view)]];
---
<div class="cyclebar-static box">
  <div class="pickers">
    <label>Forecast cycle
      <select onchange="location.href=this.value">
        {C.cycles.map((c) => <option value={keep(c, viewFor(c))} selected={c.id === cycle.id}>{c.option}</option>)}
      </select></label>
    <label>Area
      <select onchange="location.href=this.value">
        {cycle.views.map(([v, label]) => <option value={keep(cycle, v)} selected={v === view}>{label}</option>)}
      </select></label>
    <span class="research">Research reconstruction · not an official EMI or ICPAC forecast</span>
  </div>
  {(cycle.criteria || {})[view] && <p class="caveat">{cycle.criteria[view]}</p>}
  <nav class="tabs" aria-label="Section">
    {tabs.map(([k, label, u]) => <a class="tab" href={u} aria-pressed={String(k === section)}>{label}</a>)}
  </nav>
</div>
<style>
  .cyclebar-static .pickers{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center}
  .cyclebar-static .tabs{margin-top:10px}
  .cyclebar-static a.tab{text-decoration:none}
</style>
