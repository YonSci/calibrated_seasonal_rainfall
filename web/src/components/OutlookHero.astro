---
// The answer first: headline, probabilities and map side by side, then the three key figures (amount, signal, skill).
// O: the outlook pieces from lib/outlook.js (element ids kept, so the text is checked against the current page).
const { O, more = null, status = null, plain = null, exploreHref = '#explore', cycle = null } = Astro.props;  // more: [href, label]; status: the target's
// verification status; plain: the plain-language summary (lib/summary.js); cycle: the cycle (for the dates line)
import { asset, SITE } from '../lib/data.js';
import { LANGS, PUBLISHED } from '../lib/i18n.js';
const CATS = ['below', 'near', 'above'];
const pc = (x) => `${Math.round(100 * x)}%`;
// Dates of this outlook: model initialization, issue or freeze of the forecast record, last verification run, page update
const meta = Object.fromEntries(cycle?.meta ?? []);
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const day = (iso) => { const [y, m, d] = iso.split('-').map(Number); return `${d} ${MON[m - 1]} ${y}`; };
const dates = !cycle ? [] : [
  ['Model initialized', cycle.init_date ? day(cycle.init_date) : null, cycle.init_date],
  cycle.publication?.issued && cycle.publication?.date ? ['Issued', day(cycle.publication.date.slice(0, 10)), cycle.publication.date.slice(0, 10)]
    : ['Forecast frozen', (String(meta['Forecast record'] ?? '').match(/Frozen (\d{1,2} \w{3} \d{4})/) ?? [])[1] ?? null, null],
  ['Verification last run', meta['Verification last run'] && meta['Verification last run'] !== 'Not run' ? meta['Verification last run'] : null, null],
  ['Page updated', SITE.built_utc ? `${day(SITE.built_utc.slice(0, 10))} (release ${SITE.release})` : null, SITE.built_utc?.slice(0, 10)],
].filter((x) => x[1]);
---
<section id="outlooks" class="hero">
  <div class="hero-text">
    <p class="eyebrow" id="ol-eyebrow" set:html={O['ol-eyebrow']} />
    <h1 id="ol-title" set:html={O['ol-title']} />
    <p class="badges"><span class="research-inline" set:html={O['ol-publication']} />{status && <span class={`status ${status.code}`}>{status.text}</span>}</p>
    {dates.length > 0 && <p class="ol-dates">{dates.map(([k, v, iso]) => <span><span class="caveat">{k}</span> {iso ? <time datetime={iso}>{v}</time> : v}</span>)}</p>}
    <p class="lead" id="ol-lead" set:html={O['ol-lead']} />
    {plain && (
      <div class="plain-summary" id="plain-summary" data-view={plain.view} data-label={plain.label}
           data-grid={asset(`data/cells/${plain.cycle}/grid.json`)} data-cells={asset(`data/cells/${plain.cycle}/${plain.target}.json`)} data-areas={asset('data/areas.json')}>
        <div class="plain-head">
          <h2 class="plain-title" id="plain-title">In plain words</h2>
          <div class="seg lang-switch" role="group" aria-label="Language">
            {Object.entries(LANGS).filter(([k]) => PUBLISHED[k]).map(([k, l]) => <button type="button" data-lang={k} aria-pressed={k === 'en' ? 'true' : 'false'}>{l.replace(' (Amharic)', '')}</button>)}
          </div>
        </div>
        <p class="caveat plain-draft" id="plain-draft" hidden></p>
        <p id="plain-text">{plain.text}</p>
        {plain.p && (
          <>
            <div class="probbar" role="img" aria-label={`Chances across the area: below normal ${pc(plain.p[0])}, near normal ${pc(plain.p[1])}, above normal ${pc(plain.p[2])}`}>
              {CATS.map((c, k) => <span class={`pb-${c}`} style={`flex:${plain.p[k]}`}>{pc(plain.p[k])}</span>)}
            </div>
            <p class="tenths" aria-hidden="true">{CATS.map((c, k) => <span class={`t-${c}`}>{'●'.repeat(plain.tenths[k])}</span>)}</p>
            <p class="caveat" id="plain-tenths">Out of 10 seasons like this one, on average across the area: about {plain.tenths[0]} below normal, {plain.tenths[1]} near
            normal, {plain.tenths[2]} above normal. Track record here: <span class={`tr tr-${plain.track.level}`}>{plain.track.word}</span>.</p>
            <p class="caveat" set:html={O['ol-prob-note']} />
          </>
        )}
        <p class="plain-links"><a href={exploreHref}>Find your area on the map →</a></p>
      </div>
    )}
    {!plain && <div class="box"><h3>Average local probability</h3><div id="ol-prob" set:html={O['ol-prob']} /><p class="caveat" id="ol-prob-note" set:html={O['ol-prob-note']} /></div>}
    {more && <p><a class="button-link" href={more[0]}>{more[1]} →</a></p>}
  </div>
  <figure class="glance-map hero-map" id="ol-map" set:html={O['ol-map']} />
</section>
<div class="tiles">
  <div class="box"><h3>Rainfall amount</h3><div id="ol-amount" set:html={O['ol-amount']} /></div>
  <div class="box"><h3>Forecast signal</h3><div id="ol-signal" set:html={O['ol-signal']} /></div>
  <div class="box"><h3 id="ol-skill-title" set:html={O['ol-skill-title']} /><div id="ol-skill" set:html={O['ol-skill']} /></div>
</div>
<p class="caveat">Signal strength describes how far this forecast's probabilities depart from climatology. Historical skill describes how forecasts made the same way scored in past years. A strong signal is not a confidence rating.</p>
<script>
  // The plain-language summary in the chosen language (lib/i18n.js): recomputed from the cell data, as the map does.
  import * as P from '../lib/plain.js';
  import { t, langFromQuery, chooseLang, REVIEWED } from '../lib/i18n.js';
  const box = document.getElementById('plain-summary') as HTMLElement | null;
  if (box) {
    const L = langFromQuery(location.search);
    box.querySelectorAll<HTMLElement>('[data-lang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lang === L)));
    box.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-lang]');
      if (b && b.dataset.lang && b.dataset.lang !== L) chooseLang(b.dataset.lang);
    });
    if (L !== 'en') {
      Promise.all([box.dataset.grid, box.dataset.cells, box.dataset.areas].map((u) => fetch(u!).then((r) => r.json()))).then(([G, D, A]) => {
        const r = P.regional(G, D, A, G.views[box.dataset.view!] ?? G.views.all_ethiopia, box.dataset.label, L);
        document.getElementById('plain-text')!.textContent = r.text;
        document.getElementById('plain-title')!.textContent = t(L, 'inPlainWords');
        const el = document.getElementById('plain-tenths');
        if (el && r.all.p) {
          const n = P.tenths(r.all.p), tr = P.track(r.all.rpss, L);
          el.innerHTML = '';
          el.append(t(L, 'tenths', { b: n[0], n: n[1], a: n[2] }) + ' ' + t(L, 'trackHere') + ': ');
          const chip = document.createElement('span');
          chip.className = `tr tr-${tr.level}`; chip.textContent = tr.word;
          el.append(chip);
        }
        if (!REVIEWED[L]) { const d = document.getElementById('plain-draft')!; d.textContent = t(L, 'draft'); d.hidden = false; }
      }).catch(() => { /* keep the English summary */ });
    }
  }
</script>
<script>
  // Smoothed / Grid cells switch of the outlook map. Starts from ?style= (as the map viewer below) or the choice remembered
  // in this browser (shared with the viewer), else Smoothed; storage may be unavailable, which only drops the memory.
  const KEY = 'mapStyle';
  const recall = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const remember = (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* storage unavailable */ } };
  function show(style: string) {
    const fig = document.getElementById('ol-map');
    if (!fig || !fig.querySelector('.hero-switch')) return;
    fig.querySelectorAll<HTMLElement>('[data-map-style]').forEach((el) => { el.hidden = el.dataset.mapStyle !== style; });
    fig.querySelectorAll<HTMLElement>('[data-hero-style]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.heroStyle === style)));
  }
  const asked = new URLSearchParams(location.search).get('style');
  show(asked === 'cells' || asked === 'smooth' ? asked : recall() === 'cells' ? 'cells' : 'smooth');
  document.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-hero-style]');
    if (!b || !b.dataset.heroStyle) return;
    show(b.dataset.heroStyle);
    remember(b.dataset.heroStyle);
  });
</script>
<style is:global>
  .hero-switch{margin:0 0 8px}
  .hero-map [hidden]{display:none !important}
  .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:24px;align-items:start;margin-top:8px}
  .hero h1{margin:.2em 0 .1em;line-height:1.15}
  .hero-map{margin:0}
  .badges{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:0 0 6px}
  .badges .research-inline{margin:0}
  .ol-dates{display:flex;flex-wrap:wrap;gap:2px 16px;margin:0 0 6px;font-size:.85rem}
  .ol-dates>span{white-space:nowrap}
  .plain-summary{border-left:4px solid var(--accent);background:var(--surface);border-radius:0 12px 12px 0;padding:10px 16px;margin:10px 0 14px}
  .plain-summary .plain-title{font-size:1rem;margin:0 0 4px;color:var(--accent)}
  .plain-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px 12px}
  .lang-switch button{font-size:.8rem;padding:3px 9px}
  .plain-draft{font-style:italic;margin:.2em 0}
  .plain-summary p{margin:.3em 0}
  .plain-links{font-weight:600}
  .tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:14px}
  .tiles .box{margin:0}
  @media (max-width:860px){ .hero,.tiles{grid-template-columns:1fr} }
</style>
