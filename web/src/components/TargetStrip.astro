---
// Every target of a cycle as a small map with its average probabilities and verification status; each opens that target.
import { asset } from '../lib/data.js';
const { cycle, view, current = null, link } = Astro.props;      // link: (targetId) => address
const pc = (x) => (x === null || x === undefined ? '—' : `${Math.round(100 * x)}%`);
const items = cycle.targets.map((t) => {
  const f = t.forecast[view];
  return { id: t.id, label: t.label, src: f ? asset(`${f.folder}/tercile_outlook.png`) : null,
    p: f ? f.summary.mean_local_probabilities : null, status: t.status };
});
---
<ul class="strip" aria-label="Targets of this cycle">
  {items.map((i) => (
    <li><a href={link(i.id)} aria-current={i.id === current ? 'page' : undefined}>
      {i.src ? <img loading="lazy" src={i.src} alt={`${i.label}: tercile probability map`} /> : <span class="noimg">No map</span>}
      <strong>{i.label}</strong>
      <span class="caveat">{i.p ? `B ${pc(i.p[0])} · N ${pc(i.p[1])} · A ${pc(i.p[2])}` : '—'}</span>
      <span class={`status ${i.status.code}`}>{i.status.text}</span>
    </a></li>
  ))}
</ul>
<style is:global>
  .strip{list-style:none;padding:0;margin:10px 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px}
  .strip a{display:flex;flex-direction:column;gap:4px;padding:8px;border:1px solid var(--line);border-radius:12px;background:var(--surface);text-decoration:none;color:var(--ink);height:100%}
  .strip a:hover{border-color:var(--accent)}
  .strip a[aria-current="page"]{border:2px solid var(--accent);padding:7px}
  .strip img{width:100%;height:120px;object-fit:contain;background:#fff;border-radius:6px}
  .strip .noimg{height:120px;display:grid;place-items:center;color:var(--muted)}
  .strip .status{align-self:flex-start;font-size:.75rem}
</style>
