---
// "On this page": the content with a list of its headings beside it (wide screens), built from the h2 and h3 headings
// in the browser; hidden when the page has fewer than three headings.
---
<div class="with-otp">
  <div class="otp-main"><slot /></div>
  <aside class="otp" hidden><nav aria-label="On this page"><p class="otp-title">On this page</p><ol></ol></nav></aside>
</div>
<script>
  document.querySelectorAll('.with-otp').forEach((box) => {
    const main = box.querySelector('.otp-main'), aside = box.querySelector('.otp') as HTMLElement, list = aside.querySelector('ol');
    const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const used = new Set();
    const heads = [...main.querySelectorAll('h2, h3')].filter((h) => !h.closest('details:not([open])') && !h.closest('[hidden]') && h.textContent.trim());
    heads.forEach((h) => {
      if (!h.id) { let id = slug(h.textContent) || 'section', n = 2; while (used.has(id) || document.getElementById(id)) id = slug(h.textContent) + '-' + n++; h.id = id; }
      used.add(h.id);
      const li = document.createElement('li');
      li.className = h.tagName === 'H3' ? 'sub' : '';
      const a = document.createElement('a');
      a.href = '#' + h.id; a.textContent = h.textContent.replace(/\s+/g, ' ').trim();
      li.appendChild(a); list.appendChild(li);
    });
    if (heads.length >= 3) aside.hidden = false; else box.classList.add('no-otp');
    // Highlight the heading in view.
    const links = [...list.querySelectorAll('a')];
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) links.forEach((l) => l.classList.toggle('active', l.getAttribute('href') === '#' + e.target.id));
    }), { rootMargin: '-20% 0px -70% 0px' });
    heads.forEach((h) => io.observe(h));
  });
</script>
<style is:global>
  .with-otp{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:28px;align-items:start}
  .with-otp.no-otp{grid-template-columns:minmax(0,1fr)}
  .otp{position:sticky;top:150px;max-height:calc(100vh - 170px);overflow:auto;font-size:.85rem}
  .otp nav{display:block;width:100%}
  .otp-title{font-weight:600;margin:0 0 6px;color:var(--ink2)}
  .otp li a{white-space:normal;overflow-wrap:anywhere}
  .otp ol{list-style:none;padding:0;margin:0;border-left:2px solid var(--line)}
  .otp li a{display:block;padding:3px 10px;color:var(--ink2);text-decoration:none;border-left:2px solid transparent;margin-left:-2px}
  .otp li.sub a{padding-left:22px;font-size:.8rem}
  .otp li a:hover{color:var(--ink)}
  .otp li a.active{color:var(--accent);border-left-color:var(--accent);font-weight:600}
  @media (max-width:1100px){ .with-otp{grid-template-columns:minmax(0,1fr)} .otp{display:none} }
</style>
