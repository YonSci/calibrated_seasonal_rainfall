---
import Base from '../../layouts/Base.astro';
import { GLOSSARY } from '../../lib/glossary.js';
const terms = [...GLOSSARY].sort((a, b) => a[0].localeCompare(b[0], 'en', { sensitivity: 'base' }));
---
<Base title="Glossary" section="about" description="The scores, methods and terms used on the site, in one sentence each.">
  <h1>Glossary</h1>
  <p>The scores, methods and terms used on the site. On every page, the first use of a term shows its explanation when you point at it
  (or reach it with the keyboard).</p>
  <dl class="glossary">{terms.map(([t, d]) => <><dt id={t.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{t}</dt><dd>{d}</dd></>)}</dl>
  <style>
    .glossary dt{font-weight:600;margin-top:14px}
    .glossary dd{margin:2px 0 0;color:var(--ink2)}
  </style>
</Base>
