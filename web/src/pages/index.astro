---
// Home: the current outlook first (latest cycle, its rainfall domain, the season), then what is new and where to go next.
import Base from '../layouts/Base.astro';
import OutlookHero from '../components/OutlookHero.astro';
import TargetStrip from '../components/TargetStrip.astro';
import { SITE, href } from '../lib/data.js';
import { C, cycleOf, url, defaultTarget, pagesFor } from '../lib/cycles.js';
import { renderer } from '../lib/outlook.js';

const c = cycleOf(C.default);
const view = c.default_view, target = defaultTarget(c);
const R = renderer(C, { cycle: c.id, view, target }, pagesFor(c, view, target));
const O = R.outlook();
const TYPES = SITE.change_types ?? {};
const recent = [...SITE.releases].reverse().slice(0, 3);
const others = [...C.cycles].reverse().filter((x) => x.id !== c.id).map((x) => {
  const v = x.targets.filter((t) => Object.keys(t.verification || {}).length).length;
  return { x, verified: v, href: url.target(x, x.default_view, defaultTarget(x)), vhref: url.verification(x, x.default_view, defaultTarget(x)) };
});
---
<Base title="Seasonal rainfall outlook" section=""
      description="Calibrated ECMWF SEAS5 seasonal rainfall outlooks for Ethiopia: the current outlook, maps, verification against CHIRPS and historical skill.">
  <OutlookHero O={O} status={c.targets[0].status} more={[url.target(c, view, target), `Full ${c.targets[0].label} outlook and maps`]} />

  <section>
    <h2 class="h3">{c.option}: every target</h2>
    <TargetStrip cycle={c} view={view} current={target} link={(x) => url.target(c, view, x)} />
  </section>

  <div class="home-grid">
    <section class="box">
      <h2 class="h3">What's new</h2>
      <ul class="findings">
        {recent.map((r) => (
          <li><strong>{r.title}</strong> <span class="caveat">· release {r.id}, {r.date}</span><br />
            <span class="caveat">{(r.changes ?? []).map((ch) => TYPES[ch.type] ?? ch.type).filter((v, i, a) => a.indexOf(v) === i).join(' · ')}</span></li>
        ))}
      </ul>
      <p><a href={href('releases/')}>All releases and the change log →</a></p>
    </section>
    <section class="box">
      <h2 class="h3">Other forecast cycles</h2>
      <ul class="findings">
        {others.map((o) => (
          <li><a href={o.href}>{o.x.option}</a><br />
            <span class="caveat">{o.verified} of {o.x.targets.length} targets verified{o.verified > 0 && <> · <a href={o.vhref}>verification</a></>}</span></li>
        ))}
      </ul>
      <p><a href={href('outlooks/')}>All outlooks →</a></p>
    </section>
  </div>

  <section>
    <h2 class="h3">Research behind the method</h2>
    <ul class="cards">
      <li><a class="box" href={href('bias-correction/')}><strong>Bias correction</strong><span class="caveat"><br />13 rainfall-amount corrections against the operational MVS; suggestions, shadow forecasts and validation.</span></a></li>
      <li><a class="box" href={href('probability-calibration/')}><strong>Probability calibration</strong><span class="caveat"><br />Phases 1–3 against the published probabilities; the climatology blend stays.</span></a></li>
      <li><a class="box" href={href('research/amount-shadow/')}><strong>Amount and range shadow</strong><span class="caveat"><br />EMOS medians and 10–90% ranges next to the MVS ensemble, scored season by season.</span></a></li>
      <li><a class="box" href={href('research/grazfeeding/')}><strong>GrazFeediNG calibration</strong><span class="caveat"><br />The uploaded modified-Leung + Dirichlet pipeline, each stage tested against the published one.</span></a></li>
    </ul>
  </section>
  <script is:inline>
    // Links to the previous single page (its anchors and ?cycle=… views) open the matching new page, or the classic page.
    (function () {
      var map = { bias: 'bias-correction/', probcal: 'probability-calibration/', methods: 'about/methods/', domains: 'about/domains/', downloads: 'downloads/' };
      var h = location.hash.slice(1), q = location.search;
      if (map[h]) location.replace(map[h]);
      else if (/[?&]cycle=/.test(q) || ['outlooks', 'official', 'maps', 'verification', 'history'].indexOf(h) >= 0) location.replace('classic/' + q + location.hash);
    })();
  </script>
  <style is:global>
    .home-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0}
    .home-grid .box{margin:0}
    @media (max-width:860px){ .home-grid{grid-template-columns:1fr} }
  </style>
</Base>
