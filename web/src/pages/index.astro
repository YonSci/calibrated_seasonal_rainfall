---
// Home: the current outlook first (latest cycle, its rainfall domain, the season), then what is new and where to go next.
import Base from '../layouts/Base.astro';
import OutlookHero from '../components/OutlookHero.astro';
import TargetStrip from '../components/TargetStrip.astro';
import SeasonTimeline from '../components/SeasonTimeline.astro';
import { summaryFor } from '../lib/summary.js';
import { SITE, href, read } from '../lib/data.js';
import { C, cycleOf, url, defaultTarget, pagesFor } from '../lib/cycles.js';
import { renderer } from '../lib/outlook.js';

const c = cycleOf(C.default);
const view = c.default_view, target = defaultTarget(c);
const R = renderer(C, { cycle: c.id, view, target }, pagesFor(c, view, target));
const O = R.outlook();
let AREAS = [];
try { AREAS = read('areas.json').areas.map((a) => [a.id, a.name + (a.level === 3 ? ` — ${a.zone}, ${a.region}` : a.level === 2 ? ` — ${a.region}` : '')]); } catch { /* no area data */ }
const explore = url.target(c, view, target);
const plain = summaryFor(c.id, view, target, c.targets.find((x) => x.id === target).label);
const TYPES = SITE.change_types ?? {};
const recent = [...SITE.releases].reverse().slice(0, 3);
const others = [...C.cycles].reverse().filter((x) => x.id !== c.id).map((x) => {
  const v = x.targets.filter((t) => Object.keys(t.verification || {}).length).length;
  return { x, verified: v, href: url.target(x, x.default_view, defaultTarget(x)), vhref: url.verification(x, x.default_view, defaultTarget(x)) };
});
---
<Base title="Seasonal Rainfall Outlook Platform" section=""
      description="Seasonal Rainfall Outlook Platform: calibrated ECMWF SEAS5 seasonal rainfall outlooks for Ethiopia: the current outlook, maps, verification against CHIRPS and historical skill.">
  <OutlookHero O={O} cycle={c} status={c.targets[0].status} plain={plain} exploreHref={explore + '#explore'} more={[url.target(c, view, target) + '#explore', `Explore the ${c.targets[0].label} map and find your area`]} />

  {AREAS.length > 0 && (
    <section class="find-area box" id="find-area">
      <h2 class="h3">Find your area</h2>
      <p class="caveat">The {c.targets.find((x) => x.id === target).label} outlook for a region, zone or woreda, in plain words, with its track record.</p>
      <form id="fa-form" data-target={explore}>
        <input id="fa-input" list="fa-list" type="search" placeholder="Type a region, zone or woreda (e.g. Borena, Afar, Bale)" autocomplete="off" aria-label="Region, zone or woreda" />
        <datalist id="fa-list">{AREAS.map(([, n]) => <option value={n} />)}</datalist>
        <button type="submit" class="button-link">Show the outlook</button>
      </form>
      <p id="fa-msg" class="caveat" role="status" aria-live="polite"></p>
      <ul id="fa-choices" class="fa-choices" hidden></ul>
      <script type="application/json" id="fa-areas" set:html={JSON.stringify(AREAS).replace(/</g, '\\u003c')} />
    </section>
  )}

  <div class="paths">
    <a class="box path" href={explore + '#explore'}><strong class="h-display">I need the outlook</strong><span>The current forecast, the map, your area, and how far to trust it.</span></a>
    <a class="box path" href={href('research/')}><strong class="h-display">I want the science</strong><span>How the forecasts are made and tested: {read('method_summary.json')?.methods ?? 30} methods, the evidence and the method selection.</span></a>
  </div>

  <SeasonTimeline />

  <section>
    <h2 class="h3">{c.option}: every target</h2>
    <TargetStrip cycle={c} view={view} current={target} link={(x) => url.target(c, view, x)} />
  </section>

  <div class="home-grid">
    <section class="box">
      <h2 class="h3">What's new</h2>
      <ul class="findings">
        {recent.map((r) => (
          <li><strong>{r.title}</strong> <span class="caveat">· release {r.id}, {r.date}</span><br />
            <span class="caveat">{(r.changes ?? []).map((ch) => TYPES[ch.type] ?? ch.type).filter((v, i, a) => a.indexOf(v) === i).join(' · ')}</span></li>
        ))}
      </ul>
      <p><a href={href('releases/')}>All releases and the change log →</a></p>
    </section>
    <section class="box">
      <h2 class="h3">Other forecast cycles</h2>
      <ul class="findings">
        {others.map((o) => (
          <li><a href={o.href}>{o.x.option}</a><br />
            <span class="caveat">{o.verified} of {o.x.targets.length} targets verified{o.verified > 0 && <> · <a href={o.vhref}>verification</a></>}</span></li>
        ))}
      </ul>
      <p><a href={href('outlooks/')}>All outlooks →</a></p>
    </section>
  </div>

  <section>
    <h2 class="h3">Research behind the method</h2>
    <ul class="cards">
      <li><a class="box" href={href('research/')}><strong>Which methods are better</strong><span class="caveat"><br />Every method against the published approach, across the four seasons and 20 targets.</span></a></li>
      <li><a class="box" href={href('research/method-selection/')}><strong>Method selection</strong><span class="caveat"><br />The rule that turns the evidence into candidates, and their validation seasons.</span></a></li>
      <li><a class="box" href={href('research/neural-network/')}><strong>Neural network (DRN)</strong><span class="caveat"><br />A neural extension of EMOS against the published pipeline, with its ablations.</span></a></li>
      <li><a class="box" href={href('research/downscaling/')}><strong>Statistical downscaling</strong><span class="caveat"><br />CCA and PCR with SEAS5 rainfall and sea-surface temperature, the CPT approach.</span></a></li>
      <li><a class="box" href={href('bias-correction/')}><strong>Bias correction</strong><span class="caveat"><br />Twelve rainfall-amount corrections against the operational MVS; suggestions, shadow forecasts and validation.</span></a></li>
      <li><a class="box" href={href('probability-calibration/')}><strong>Probability calibration</strong><span class="caveat"><br />Phases 1–3 against the published probabilities; the climatology blend stays.</span></a></li>
      <li><a class="box" href={href('research/amount-shadow/')}><strong>Amount and range shadow</strong><span class="caveat"><br />EMOS medians and 10–90% ranges next to the MVS ensemble, scored season by season.</span></a></li>
      <li><a class="box" href={href('research/leung-dirichlet/')}><strong>Leung–Dirichlet calibration</strong><span class="caveat"><br />Member-wise modified-Leung correction + identity-anchored Dirichlet, each stage tested against the published one.</span></a></li>
    </ul>
  </section>
  <script is:inline>
    // Links to the previous single page (its anchors and ?cycle=… views) open the matching new page, or the classic page.
    (function () {
      var map = { bias: 'bias-correction/', probcal: 'probability-calibration/', methods: 'about/methods/', domains: 'about/domains/', downloads: 'downloads/' };
      var h = location.hash.slice(1), q = location.search;
      if (map[h]) location.replace(map[h]);
      else if (/[?&]cycle=/.test(q) || ['outlooks', 'official', 'maps', 'verification', 'history'].indexOf(h) >= 0) location.replace('classic/' + q + location.hash);
    })();
  </script>
  <style is:global>
    .home-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0}
    .home-grid .box{margin:0}
    @media (max-width:860px){ .home-grid{grid-template-columns:1fr} }
  </style>
  <script>
    // Find your area: the chosen place opens the current outlook at that area (the outlook page's ?area= parameter).
    const form = document.getElementById('fa-form');
    if (form) {
      const list: [string, string][] = JSON.parse(document.getElementById('fa-areas')!.textContent || '[]');
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const v = (document.getElementById('fa-input') as HTMLInputElement).value.trim().toLowerCase();
        const msg = document.getElementById('fa-msg')!, box = document.getElementById('fa-choices')!;
        const go = (id: string) => { location.href = (form as HTMLElement).dataset.target + '?area=' + encodeURIComponent(id) + '#explore'; };
        box.hidden = true; box.innerHTML = '';
        if (!v) { msg.textContent = 'Type the name of a region, zone or woreda first.'; return; }
        const exact = list.filter(([, n]) => n.toLowerCase() === v || n.toLowerCase().split(' — ')[0] === v);
        if (exact.length === 1) { go(exact[0][0]); return; }
        const hits = exact.length ? exact : list.filter(([, n]) => n.toLowerCase().startsWith(v));
        const loose = hits.length ? hits : list.filter(([, n]) => n.toLowerCase().includes(v));
        if (loose.length === 1) { go(loose[0][0]); return; }
        if (!loose.length) { msg.textContent = `No region, zone or woreda matches “${v}”. Check the spelling, or try a shorter part of the name.`; return; }
        msg.textContent = `${loose.length} places match “${v}”${loose.length > 12 ? '; the first 12' : ''}. Choose one:`;
        loose.slice(0, 12).forEach(([id, n]) => {
          const li = document.createElement('li'), b = document.createElement('button');
          b.type = 'button'; b.className = 'linkbtn'; b.textContent = n; b.addEventListener('click', () => go(id));
          li.append(b); box.append(li);
        });
        box.hidden = false;
      });
    }
  </script>
  <style is:global>
    .find-area form{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
    .find-area input{font:inherit;padding:10px 14px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);flex:1 1 320px}
    .find-area button{border:none;cursor:pointer;font:inherit}
    .fa-choices{list-style:none;padding:0;margin:4px 0 0;columns:2 260px;font-size:.92rem}
    .fa-choices li{margin:2px 0;break-inside:avoid}
    .find-area .fa-choices button.linkbtn{background:none;padding:0;text-align:left}
    .paths{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}
    .paths .path{display:block;text-decoration:none;color:var(--ink);padding:18px 20px}
    .paths .path strong{display:block;font-size:1.3rem;color:var(--accent);margin-bottom:4px}
    .paths .path:hover{border-color:var(--accent)}
    @media (max-width:720px){ .paths{grid-template-columns:1fr} }
  </style>
</Base>
