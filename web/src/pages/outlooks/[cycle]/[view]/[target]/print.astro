---
// One-page outlook for printing or saving as PDF (A4 portrait): the summary in plain words, the probabilities, the tercile map,
// the key figures and a table of the regions, with the dates and the publication status. Built from the same data as the
// outlook page (lib/outlook.js, lib/summary.js).
import Bare from '../../../../../layouts/Bare.astro';
import { C, cycleOf, pagesFor, url } from '../../../../../lib/cycles.js';
import { renderer } from '../../../../../lib/outlook.js';
import { summaryFor, regionsFor } from '../../../../../lib/summary.js';
import { SITE, ROOT } from '../../../../../lib/data.js';

export function getStaticPaths() {
  return C.cycles.flatMap((c) => c.views.flatMap(([view]) => c.targets.map((t) => ({ params: { cycle: c.id, view, target: t.id } }))));
}
const { cycle: cid, view, target } = Astro.params;
const c = cycleOf(cid);
const R = renderer(C, { cycle: cid, view, target }, pagesFor(c, view, target));
const O = R.outlook();
const M = R.maps();
const t = c.targets.find((x) => x.id === target);
const plain = summaryFor(cid, view, target, t.label);
const regions = regionsFor(cid, view, target);
const map = M.forecast ? `${M.forecast.folder}/tercile_outlook.png` : null;
const CATS = ['below', 'near', 'above'];
const NAME = { below: 'Below normal', near: 'Near normal', above: 'Above normal' };
const pc = (x) => (x == null ? '—' : `${Math.round(100 * x)}%`);
const mm = (x) => (x == null ? '—' : `${Math.round(x)}`);
const meta = Object.fromEntries(c.meta ?? []);
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const day = (iso) => { const [y, m, d] = iso.split('-').map(Number); return `${d} ${MON[m - 1]} ${y}`; };
const frozen = (String(meta['Forecast record'] ?? '').match(/Frozen (\d{1,2} \w{3} \d{4})/) ?? [])[1];
const page = new URL(url.target(c, view, target), Astro.site ?? 'https://yonsci.github.io').href;
const trackWord = (r) => (r == null || !Number.isFinite(r) ? '—' : r <= 0 ? 'low' : r < 0.05 ? 'modest' : r < 0.15 ? 'fair' : 'good');
---
<Bare title={`${t.label} rainfall outlook (print) · ${R.viewLabel(view)}`} description={`One-page ${t.label} rainfall outlook for Ethiopia, ${R.viewLabel(view)}.`} robots="noindex">
  <div class="sheet-actions">
    <button type="button" onclick="window.print()">Print or save as PDF</button>
    <a href={url.target(c, view, target)}>← Back to the outlook page</a>
  </div>
  <article class="sheet">
    <header class="sh-head">
      <div>
        <p class="sh-brand">Seasonal Rainfall Outlook Platform · Ethiopia</p>
        <h1>{t.label} rainfall outlook</h1>
        <p class="sh-sub" set:html={O['ol-eyebrow']} />
      </div>
      <p class="sh-status">{c.publication?.short ?? 'Research reconstruction · not an official forecast'}</p>
    </header>
    <p class="sh-dates">
      Model initialized {day(c.init_date)}{frozen ? ` · forecast frozen ${frozen}` : ''} · target period {day(t.start)} – {day(t.end)}
      · status: {t.status.text} · printed from release {SITE.release}
    </p>

    <div class="sh-main">
      <div class="sh-left">
        {plain ? (
          <>
            <h2>In plain words</h2>
            <p>{plain.text}</p>
            {plain.p && (
              <>
                <div class="probbar" role="img" aria-label={`Below normal ${pc(plain.p[0])}, near normal ${pc(plain.p[1])}, above normal ${pc(plain.p[2])}`}>
                  {CATS.map((k, i) => <span class={`pb-${k}`} style={`flex:${plain.p[i]}`}>{pc(plain.p[i])}</span>)}
                </div>
                <p class="sh-key">{CATS.map((k) => <span><i class={`pb-${k}`}></i>{NAME[k]}</span>)}</p>
                <p class="tenths" aria-hidden="true">{CATS.map((k, i) => <span class={`t-${k}`}>{'●'.repeat(plain.tenths[i])}</span>)}</p>
                <p class="sh-small">Out of 10 seasons like this one, on average across the area: about {plain.tenths[0]} below normal, {plain.tenths[1]} near normal and {plain.tenths[2]} above normal.</p>
              </>
            )}
          </>
        ) : <p set:html={O['ol-lead']} />}
      </div>
      {map && <figure class="sh-map"><img src={map} alt={`Tercile outlook map, ${t.label}, ${R.viewLabel(view)}`} /></figure>}
    </div>
    <div class="sh-figs">
      <div><h3>Rainfall amount</h3><div set:html={O['ol-amount']} /></div>
      <div><h3>Forecast signal</h3><div set:html={O['ol-signal']} /></div>
      <div><h3>Historical skill</h3><div set:html={O['ol-skill']} /></div>
    </div>

    {regions.length > 0 && (
      <table class="sh-table nosort">
        <caption>By region: area-mean chances of each category, expected and normal rainfall ({c.reference}), and the track record of forecasts made this way</caption>
        <thead><tr><th scope="col">Region</th><th scope="col">Below</th><th scope="col">Near</th><th scope="col">Above</th><th scope="col">Favoured</th><th scope="col">Expected (mm)</th><th scope="col">Normal (mm)</th><th scope="col">Track record</th></tr></thead>
        <tbody>
          {regions.map((r) => (
            <tr>
              <th scope="row">{r.name}</th>
              {[0, 1, 2].map((i) => <td class={r.p && r.favoured === CATS[i] ? `fav t-${CATS[i]}` : ''}>{r.p ? pc(r.p[i]) : '—'}</td>)}
              <td>{r.favoured ? NAME[r.favoured].toLowerCase() : r.p ? 'none' : 'dry season'}</td>
              <td>{mm(r.mean)}</td><td>{mm(r.normal)}</td><td>{trackWord(r.rpss)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <footer class="sh-foot">
      <p><strong>How to read this.</strong> Each 0.25° grid cell has its own chances of below-, near- and above-normal rainfall (terciles of {c.reference}); the
      numbers here are averages over the area. "Favoured" means one category has at least 36% on average. A strong signal is not a confidence rating; the
      track record says how forecasts made the same way scored in past years.</p>
      <p>ECMWF SEAS5 calibrated with {c.obs} (mean–variance scaling and a climatology blend). {c.publication?.footer ?? 'Research reconstruction; not an official EMI or ICPAC forecast.'}
      Boundaries: OCHA COD-AB, for orientation only. Online, with the interactive map: {page}</p>
    </footer>
  </article>
  <style is:global>
    body{margin:0;font-family:Inter,system-ui,sans-serif}
    .sheet-actions{display:flex;gap:16px;align-items:center;justify-content:center;padding:12px;font-size:.9rem}
    .sheet-actions button{font:inherit;font-weight:600;padding:8px 16px;border-radius:999px;border:0;background:var(--accent);color:#fff;cursor:pointer}
    .sheet{width:210mm;min-height:297mm;margin:0 auto 24px;padding:10mm 12mm;background:#fff;color:#0b0b0b;box-shadow:0 2px 18px rgba(0,0,0,.12);font-size:9.6pt;line-height:1.4}
    .sheet h1{font-size:21pt;margin:0;line-height:1.1}
    .sheet h2{font-size:12pt;margin:0 0 3px;color:#1f6f5c}
    .sheet h3{font-size:9.5pt;margin:0 0 2px}
    .sh-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;border-bottom:2px solid #1f6f5c;padding-bottom:5px}
    .sh-brand{margin:0;font-size:8.5pt;font-weight:600;color:#1f6f5c;text-transform:uppercase;letter-spacing:.04em}
    .sh-sub{margin:2px 0 0;color:#52514e;font-size:9pt}
    .sh-status{margin:0;max-width:52mm;text-align:right;font-size:8pt;color:#8a5a00;background:#fdf1d8;border-radius:6px;padding:3px 7px}
    .sh-dates{margin:5px 0 8px;font-size:8.5pt;color:#52514e}
    .sh-main{display:grid;grid-template-columns:1fr 92mm;gap:5mm;align-items:start}
    .sh-left p{margin:.25em 0}
    .sh-map{margin:0}
    .sh-map img{width:100%;height:auto;display:block;border:1px solid #e1e0dc;border-radius:4px}
    .sheet .probbar{height:22px;margin:6px 0 2px;font-size:8.5pt}
    .sh-key{display:flex;gap:10px;font-size:8pt;color:#52514e;margin:0}
    .sh-key i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:4px;vertical-align:-1px}
    .sh-key .pb-below{background:var(--below)}.sh-key .pb-near{background:var(--near)}.sh-key .pb-above{background:var(--above)}
    .sheet .tenths{font-size:12pt;margin:3px 0 0}
    .sh-small,.sheet .caveat{font-size:8pt;color:#52514e}
    .sh-figs{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-top:6px}
    .sh-figs .caveat{display:none}
    .sh-figs>div{border:1px solid #e1e0dc;border-radius:6px;padding:5px 8px}
    .sh-figs .big{font-weight:700;margin:0;font-size:9.6pt;line-height:1.3}
    .sh-figs .amount{display:flex;gap:10px;flex-wrap:wrap}.sh-figs .amount span{display:block;font-size:7.6pt;color:#52514e}.sh-figs .amount b{font-size:10pt}
    .sh-table{width:100%;border-collapse:collapse;margin-top:8px;font-size:8.6pt}
    .sh-table caption{text-align:left;font-size:8.5pt;color:#52514e;padding-bottom:3px}
    .sh-table th,.sh-table td{border-bottom:1px solid #e1e0dc;padding:1.8px 5px;text-align:right;background:none;color:#0b0b0b}
    .sh-table th::after{content:none!important}
    .sh-table th[scope=row],.sh-table thead th:first-child{text-align:left}
    .sh-table thead th{border-bottom:1.5px solid #52514e;font-weight:600}
    .sh-table td.fav{font-weight:700}
    .sh-foot{margin-top:8px;border-top:1px solid #e1e0dc;padding-top:5px;font-size:7.6pt;color:#52514e}
    .sh-foot p{margin:.25em 0}
    .sheet a{color:inherit}
    @page{size:A4 portrait;margin:0}
    @media print{
      body{background:#fff}
      .sheet-actions{display:none}
      .sheet{box-shadow:none;margin:0;width:auto;min-height:0}
      *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    }
    @media screen and (max-width:820px){ .sheet{width:auto;min-height:0;padding:16px;margin:0 8px 16px} .sh-main{grid-template-columns:1fr} }
  </style>
</Bare>
