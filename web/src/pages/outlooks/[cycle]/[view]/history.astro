---
// Address of release 2026-10-14.5: forwards to the season target's skill page.
import { C, cycleOf, url, seasonTarget } from '../../../../lib/cycles.js';

export function getStaticPaths() {
  return C.cycles.flatMap((c) => c.views.map(([view]) => ({ params: { cycle: c.id, view } })));
}
const { cycle: cid, view } = Astro.params;
const c = cycleOf(cid);
const to = url.skill(c, view, seasonTarget(c));
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta http-equiv="refresh" content={`0; url=${to}`}><link rel="canonical" href={to}><title>Moved</title></head>
<body><p>This page has moved: <a href={to}>{to}</a></p></body></html>
