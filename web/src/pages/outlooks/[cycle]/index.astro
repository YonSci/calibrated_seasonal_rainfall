---
// A cycle's address: forwards to its default area and first target (the current page's default state).
import Base from '../../../layouts/Base.astro';
import { C, cycleOf, url, defaultTarget } from '../../../lib/cycles.js';

export function getStaticPaths() {
  return C.cycles.map((c) => ({ params: { cycle: c.id } }));
}
const c = cycleOf(Astro.params.cycle);
const to = url.target(c, c.default_view, defaultTarget(c));
---
<Base title={c.option} section="outlooks/" description={`${c.option}: seasonal rainfall outlook for Ethiopia.`}>
  <meta http-equiv="refresh" content={`0; url=${to}`} slot="head" />
  <p><a href={to}>{c.option}: open the outlook</a></p>
</Base>
