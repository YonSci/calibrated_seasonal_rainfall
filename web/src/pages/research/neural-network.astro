---
// Neural distributional regression (DRN, censored shifted gamma) against the published pipeline and EMOS
// (scripts/neural_calibration.py, scripts/dist_benchmark.py with config/probability_calibration/<cycle>_neural.json, docs/54).
import Base from '../../layouts/Base.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import Table from '../../components/Table.astro';
import Figure from '../../components/Figure.astro';
import InShort from '../../components/InShort.astro';
import { drnDiagram } from '../../lib/drn_diagram.js';
import { candidates } from '../../lib/evidence.js';
import { read, names, href, link, esc, signed, num, years, cycleTitle, REPO } from '../../lib/data.js';

const INIT = { jan: 1, feb: 2, may: 5, sep: 9 };
const EXT = names('neural_ext');                     // second stage: SST inputs, neural correction of EMOS, forecast-only ablation
const POOLED = names('neural_pooled'), TUNING = names('neural_tuning');
const POOLED2 = names('neural_pooled2'), ALL = names('neural_all'), STACK = names('stacking');   // third stage (docs/54, 3g)
const maybe = (list, sub, n) => (list.includes(n) ? read(`${sub}/${n}.json`) : null);
const cycles = names('neural').map((n) => ({ name: n, d: read(`neural/${n}.json`), x: maybe(EXT, 'neural_ext', n),
  p: maybe(POOLED, 'neural_pooled', n), u: maybe(TUNING, 'neural_tuning', n), p2: maybe(POOLED2, 'neural_pooled2', n),
  all: maybe(ALL, 'neural_all', n), st: maybe(STACK, 'stacking', n) }))
  .map((x) => ({ ...x, title: cycleTitle(INIT[x.name.split('_')[0]], x.name.split('_')[1].toUpperCase()) }))
  .sort((a, b) => INIT[a.name.split('_')[0]] - INIT[b.name.split('_')[0]]);
const SHORT = { incumbent: 'Published probabilities', mvs_ensemble: 'MVS ensemble (published amounts)', emos_csg: 'EMOS',
  drn_csg: 'DRN', drn_linear_csg: 'Linear control', drn_climatology: 'No-forecast ablation', drn_forecast_only: 'Forecast-only ablation',
  drn_sst: 'DRN + SST', drn_regions: 'DRN + regions (no SST)', quantile_regression: 'Quantile regression', drn_emos_residual: 'Neural EMOS correction', drn_pooled: 'Pooled DRN', drn_csg_tuned: 'DRN, separate tuning',
  drn_pooled_residual: 'Pooled neural EMOS correction', drn_pooled_nbhd: 'Pooled DRN + neighbourhood', drn_pooled_all: 'DRN pooled over all cycles',
  stack: 'Combination (EMOS + QR + DRN)' };

// The method selection's decision (docs/50): Benjamini–Hochberg across the decision model's targets, per score
function bhDecisions(d, score) {
  const keys = (d.decision_models ?? []).flatMap((k) => Object.keys(d.tests[k]?.[score] ?? {}).map((t) => [k, t]));
  const order = keys.map(([k, t]) => ({ k, t, p: d.tests[k][score][t].training.p_improvement })).sort((a, b) => a.p - b.p);
  const out = {};
  let run = 1;
  for (let i = order.length - 1; i >= 0; i--) {
    run = Math.min(run, order[i].p * order.length / (i + 1));
    const x = d.tests[order[i].k][score][order[i].t];
    const adj = Math.min(1, run);
    out[`${order[i].k}|${order[i].t}`] = { p: adj, confirmed: x.training.mean_difference < 0 && adj < 0.05 && x.test.mean_difference <= 0 };
  }
  return out;
}
const confirmedList = (d, rule) => ['rps', 'crps'].flatMap((sc) => {
  const bh = bhDecisions(d, sc);
  return (d.decision_models ?? []).flatMap((k) => Object.entries(d.tests[k]?.[sc] ?? {})
    .filter(([t, x]) => (rule === 'bh' ? bh[`${k}|${t}`]?.confirmed : x.decision.confirmed))
    .map(([t]) => ((d.decision_models ?? []).length > 1 ? `${SHORT[k] ?? k}: ` : '') + `${t} (${sc === 'rps' ? 'probabilities' : 'amounts'})`));
});

function skillTable(d, score, cand = 'drn_csg') {
  const reg = d.primary_region;
  const key = score === 'rps' ? 'rpss' : 'crpss';
  const ref = score === 'rps' ? 'incumbent' : 'mvs_ensemble';
  const ks = [ref, ...d.models];
  const bh = bhDecisions(d, score);
  const rows = Object.keys(d.targets).map((t) => {
    const x = d.tests[cand]?.[score]?.[t];
    return [`<strong>${esc(t)}</strong>`, ...ks.map((k) => signed(d.targets[t].methods[k].training[reg][key])),
      ...ks.map((k) => signed(d.targets[t].methods[k].test[reg][key])),
      x ? `${num(x.decision.holm_p_family, 3)} / ${num(bh[`${cand}|${t}`].p, 3)}` : '—',
      x ? (bh[`${cand}|${t}`].confirmed ? '<strong>✓ candidate</strong>' : x.decision.no_harm ? 'not confirmed' : 'not confirmed; worse over the test years') : '—'];
  });
  const k1 = ks.map((k) => `${SHORT[k] ?? k} ${years(d.training_years)}`);
  const k2 = ks.map((k) => `${SHORT[k] ?? k} ${years(d.test_years)}`);
  return { head: ['Target', ...k1, ...k2, `${SHORT[cand]} p (Holm / BH)`, `${SHORT[cand]} (selection rule)`], rows,
    caption: `${key.toUpperCase()} against the observed climatology over ${d.regions[reg]}: leave-one-year-out ${years(d.training_years)}, then fitted on ${years(d.training_years)} and scored ${years(d.test_years)}.` };
}
function coverageTable(d) {
  const reg = d.primary_region;
  const ks = ['mvs_ensemble', ...d.models];
  const cell = (m) => {
    const c = m.training[reg].coverage_80, w = m.training[reg].width_80;
    return c == null ? '—' : `${Math.round(c * 100)}%` + (w == null ? '' : ` · ${Math.round(w)} mm`);
  };
  return { head: ['Target', ...ks.map((k) => SHORT[k] ?? k), 'Climatology width'],
    rows: Object.keys(d.targets).map((t) => [`<strong>${esc(t)}</strong>`, ...ks.map((k) => cell(d.targets[t].methods[k])),
      (() => { const w = d.targets[t].methods.mvs_ensemble.training[reg].width_80_clim; return w == null ? '—' : `${Math.round(w)} mm`; })()]),
    caption: `Coverage of the 10–90% range (nominal 80%) · its mean width, ${years(d.training_years)}. Coverage alone can be bought with wide ranges: a calibrated range narrower than climatology's is the aim.` };
}
function brierTable(d) {
  const reg = d.primary_region;
  const ks = ['incumbent', ...d.models];
  return { head: ['Target', ...ks.flatMap((k) => [`${SHORT[k] ?? k} below`, 'above'])],
    rows: Object.keys(d.targets).map((t) => [`<strong>${esc(t)}</strong>`, ...ks.flatMap((k) => {
      const m = d.targets[t].methods[k].training[reg];
      return [m.bss_below, m.bss_above].map((v) => (v == null ? '—' : signed(v)));
    })]),
    caption: `Brier skill of the below- and above-normal probabilities against climatology, ${years(d.training_years)} (leave-one-year-out).` };
}
function domainTable(d, reg) {
  const ks = [['incumbent', 'rpss'], ['drn_csg', 'rpss'], ['mvs_ensemble', 'crpss'], ['emos_csg', 'crpss'], ['drn_csg', 'crpss'], ['drn_climatology', 'crpss']];
  return { head: ['Target', ...ks.map(([k, key]) => `${key.toUpperCase()} ${SHORT[k] ?? k}`)],
    rows: Object.keys(d.targets).map((t) => [`<strong>${esc(t)}</strong>`, ...ks.map(([k, key]) => {
      const v = d.targets[t].methods[k].training[reg]?.[key];
      return v == null ? '—' : signed(v);
    })]),
    caption: `${d.regions[reg]}, ${years(d.training_years)} (leave-one-year-out). The tests and the method selection use ${d.regions[d.primary_region]}.` };
}
const ci = (x) => (x?.bootstrap_95 ? `${signed(x.bootstrap_95[0], 3)} to ${signed(x.bootstrap_95[1], 3)}` : '—');
function testTable(d, score, cand = 'drn_csg') {
  const bh = bhDecisions(d, score);
  return { head: ['Target', `Δ${score.toUpperCase()} ${years(d.training_years)}`, '95% interval', 'Years better', 'p (one-sided)', 'Holm / BH',
    `Δ${score.toUpperCase()} ${years(d.test_years)}`, 'Selection rule'],
    rows: Object.entries(d.tests[cand]?.[score] ?? {}).map(([t, x]) => [`<strong>${esc(t)}</strong>`, signed(x.training.mean_difference, 3), ci(x.training),
      `${x.training.years_better} of ${x.training.years}`, num(x.training.p_improvement, 3),
      `${num(x.decision.holm_p_family, 3)} / ${num(bh[`${cand}|${t}`].p, 3)}`, signed(x.test.mean_difference, 3),
      bh[`${cand}|${t}`].confirmed ? '<strong>✓ candidate</strong>' : '—']),
    caption: `${SHORT[cand]} against the ${score === 'rps' ? 'published probabilities (RPS)' : 'MVS-corrected ensemble (CRPS, mm)'}: paired whole-year differences; negative favours the model; 95% interval: whole-year bootstrap.` };
}
function comparisonTable(d, score) {
  const rows = [];
  for (const [pair, s] of Object.entries(d.comparisons ?? {})) {
    const other = pair.split('|')[1];
    for (const [t, x] of Object.entries(s[score] ?? {})) {
      rows.push([`<strong>${esc(t)}</strong>`, `<span data-cmp="${esc(other)}">${esc(`${SHORT[pair.split('|')[0]] ?? pair.split('|')[0]} against ${SHORT[other] ?? other}`)}</span>`, signed(x.training.mean_difference, 4), ci(x.training),
        `${x.training.years_better} of ${x.training.years}`, num(x.training.p_improvement, 3), signed(x.test.mean_difference, 4),
        `${x.test.years_better} of ${x.test.years}`]);
    }
  }
  return { head: ['Target', 'Comparison', `Δ${score.toUpperCase()} ${years(d.training_years)}`, '95% interval', 'Years first better', 'p (one-sided)',
    `Δ${score.toUpperCase()} ${years(d.test_years)}`, 'Years first better'], rows };
}
const chosen = (d) => {
  const n = new Map();
  for (const t of Object.values(d.targets)) {
    const f = t.fitted?.drn_csg;
    if (f?.hidden) {
      const key = `${f.hidden.join('–')} units` + (f.decay != null ? `, decay ${f.decay}` : '');
      n.set(key, (n.get(key) ?? 0) + 1);
    }
  }
  return [...n].map(([h, c]) => `${h} (${c} target${c === 1 ? '' : 's'})`).join('; ') || '—';
};
// The model at a glance, input data, outputs (lib/drn_diagram.js; the numbers below come from the benchmark files and the cell data)
const TRAIN = cycles[0]?.d.training_years ?? [1993, 2016], TEST = cycles[0]?.d.test_years ?? [2017, 2025];
const fmt = (n) => Number(n).toLocaleString('en');
const INPUT_ROWS = [
  ['SEAS5 ensemble', 'Ensemble mean', 'Mean of the 25 members, divided by the cell’s SEAS5 mean over the training years'],
  ['SEAS5 ensemble', 'Ensemble median', 'Median of the members (relative, as above)'],
  ['SEAS5 ensemble', 'Standard deviation', 'Spread of the members (relative)'],
  ['SEAS5 ensemble', 'Mean absolute difference', 'Average |xᵢ − xⱼ| over all pairs of members: the spread measure of EMOS (relative)'],
  ['SEAS5 ensemble', '10% and 90% quantiles', 'The lower and upper tails of the members (relative)'],
  ['Local climate', 'Log mean rainfall', 'Log of the cell’s CHIRPS mean over the training years (mm): how wet the cell normally is'],
  ['Local climate', 'Coefficient of variation', 'Standard deviation ÷ mean of the cell’s CHIRPS totals over the training years: how variable it is'],
  ['Location', 'Latitude, longitude', 'Centre of the 0.25° cell: lets the network treat regions differently'],
];
const layers = (h) => [10, ...h, 3].reduce((n, a, i, all) => (i ? n + all[i - 1] * a + a : n), 0);
const PARAMS = [layers([32]), layers([32, 16])];
// cells with rainfall (CHIRPS mean at least 1 mm) per target, from the site's cell data
const CELLS = (() => {
  const n = [];
  for (const id of ['fmam2026', 'jjas2026', 'ondj2026']) {
    try {
      for (const t of names(`cells/${id}`).filter((x) => x !== 'grid')) n.push(read(`cells/${id}/${t}.json`).normal.filter((v) => v != null && v >= 1).length);
    } catch { /* no cell data */ }
  }
  return n.length ? { min: Math.min(...n), max: Math.max(...n) } : { min: 0, max: 0 };
})();
const CYCLE_NAME = { jan_fmam: 'FMAM (Jan)', feb_fmam: 'FMAM (Feb)', may_jjas: 'JJAS (May)', sep_ondj: 'ONDJ (Sep)' };
const SUP = { '-': '⁻', 0: '⁰', 1: '¹', 2: '²', 3: '³', 4: '⁴', 5: '⁵', 6: '⁶', 7: '⁷', 8: '⁸', 9: '⁹' };
const decayText = (v) => (Number(v) === 0 ? '0' : '10' + String(Math.round(Math.log10(Number(v)))).split('').map((ch) => SUP[ch]).join(''));
const optionText = (k) => { const [h, d] = k.split('|'); const units = JSON.parse(h); return `${units.length ? units.join(' + ') : 'linear'}, ${decayText(d)}`; };
const CHOSEN = cycles.flatMap(({ name, d }) => Object.entries(d.targets).map(([t, x]) => {
  const f = x.fitted?.drn_csg;
  return f && { cycle: CYCLE_NAME[name] ?? name, target: t, hidden: f.hidden.join(' + '), decay: decayText(f.decay),
    steps: (f.steps ?? []).join(', '), options: Object.entries(f.validation_crps ?? {}).map(([k, v]) => `${optionText(k)}: ${v.toFixed(4)}`).join(' · ') };
}).filter(Boolean));
// The experiment shown: the accepted result of each cycle (config/accepted_results.json), what it searched, and pending runs
let ACC = { accepted: {}, status: [] };
try { ACC = read('accepted.json'); } catch { /* older build: no registry */ }
const shown = cycles.map(({ name, d }) => ({ name, a: d.accepted ?? ACC.accepted[`neural/${name}`] ?? null }));
const EXP = [...new Set(shown.map((s) => s.a?.experiment).filter(Boolean))];
const SEARCHED = [...new Set(shown.flatMap((s) => s.a?.searched?.drn_csg ?? []))].map((k) => k.split('|'));
const UNITS = [...new Set(SEARCHED.map(([h]) => JSON.parse(h).join('–')))], DECAYS = [...new Set(SEARCHED.map(([, v]) => decayText(v)))];
const SEARCH_TEXT = SEARCHED.length
  ? `Architecture (${UNITS.join(' or ')} units)` + (DECAYS.length > 1 ? ` × weight decay (${DECAYS.join(' or ')})` : `, weight decay ${DECAYS[0]}`) + ' chosen by held-out CRPS'
  : undefined;
const created = shown.map((s) => s.a?.created_utc).filter(Boolean).sort();
const commits = [...new Set(shown.map((s) => s.a?.code_commit ?? s.a?.commit).filter(Boolean))];
const PENDING = (ACC.status ?? []).filter((r) => r.family === 'neural' && r.pending);
const NOT_RUN = ['neural_ext', 'neural_pooled', 'neural_tuning', 'neural_pooled2', 'neural_all', 'stacking'].filter((f) => !(ACC.status ?? []).some((r) => r.family === f && (r.accepted || r.pending)));
const FAMILY = { neural_ext: 'second stage (SST and regions, neural correction of EMOS)', neural_pooled: 'pooled network', neural_tuning: 'separate tuning split',
  neural_pooled2: 'pooled neural EMOS correction and neighbourhood inputs', neural_all: 'one network for all four cycles', stacking: 'model combination' };
// Selectors (product, comparator): the comparators present in any cycle's comparisons
const COMPARATORS = [...new Set(cycles.flatMap((c) => [c.d, c.x, c.p, c.u, c.p2, c.all, c.st].filter(Boolean)
  .flatMap((d) => Object.keys(d.comparisons ?? {}).map((k) => k.split('|')[1]))))];
const SHADOW = candidates('drn_csg').map((c) => `${c.season} ${c.target} ${c.product === 'amounts' ? 'amounts' : 'probabilities'}`);
---
<Base title="Neural network (DRN)" section="research" description="A distributional regression network (neural EMOS with a censored shifted gamma) tested against the published pipeline and EMOS.">
  <OnThisPage>
    <h1>Neural network: distributional regression (DRN)</h1>
    <InShort lead="A small neural network learns each cell's full rainfall distribution from the SEAS5 ensemble. It is a research comparison: the published forecasts do not use it." methods={['drn_csg']} />
    <p>A small neural network that turns the SEAS5 ensemble and the local rainfall climate of each grid cell into a full rainfall
    distribution: the censored shifted gamma of the EMOS model, with its parameters learned by a network instead of two linear formulas.
    From the distribution come rainfall amounts, 10–90% ranges and tercile probabilities. It is tested against the published pipeline and
    against EMOS, with the same data, folds and tests as the other distribution models.</p>
    <p class="notice"><strong>A comparison, not a published forecast.</strong> The published forecasts keep the published approach. If the
    DRN is confirmed better for a target, it becomes a candidate in the <a href={href('research/method-selection/')}>method selection</a>
    and needs three validation seasons before it can be recommended.</p>

    <h2 id="what">What is compared</h2>
    <ul class="findings">
      <li><strong>DRN (the candidate):</strong> one network shared by every cell of a target, with one or two hidden layers (32, or 32 and 16 units), chosen inside each fold.</li>
      <li><strong>EMOS:</strong> the existing censored shifted gamma model (ensemble mean and spread, linear), in the same folds: does the network add anything?</li>
      <li><strong>Linear control:</strong> the DRN's inputs and training, without a hidden layer: is a gain due to the network or to the extra inputs and the CRPS loss?</li>
      <li><strong>No-forecast ablation:</strong> the network with only the local climate and location: does the SEAS5 forecast add anything beyond the cell's normal rainfall?</li>
      <li><strong>References:</strong> the published probabilities (MVS and the climatology blend; RPS) and the MVS-corrected ensemble (CRPS). Every model uses the first 25 SEAS5 members in every year, the 2027 policy.</li>
      <li><strong>Second stage</strong> (a separate benchmark, its own two candidates): the DRN with SEAS5 Niño 3.4 and Indian Ocean Dipole indices of the target months and the EMI rainfall regions (Korecha &amp; Sorteberg 2013), which gives the network large-scale information; a neural correction of EMOS, which starts exactly at EMOS and can only move away from it where held-out years improve; and a forecast-only ablation (no climate or location inputs).</li>
    </ul>
    <p class="caveat">Only the DRN is tested for adoption (5 targets per cycle and score). EMOS, the control and the ablation are diagnostic comparisons and do not enter the multiple-testing adjustment.</p>

    <h2 id="model">The model at a glance</h2>
    <figure class="drn-fig" set:html={drnDiagram(undefined, { search: SEARCH_TEXT })} />
    <p class="caveat">The same network is shared by every grid cell of a target and fitted again inside every fold. Code:
    <a href={`${REPO}/blob/main/scripts/neural_calibration.py`}><code>scripts/neural_calibration.py</code></a>; full description in
    <a href={`${REPO}/blob/main/docs/54_NEURAL_DISTRIBUTIONAL_REGRESSION.md`}>docs/54</a>.</p>

    <h2 id="inputs">Input data</h2>
    <div class="table-wrap"><table class="compact nosort drn-table">
      <caption>Data the network learns from</caption>
      <tbody>
        <tr><th scope="row">Forecast</th><td>ECMWF SEAS5 (system 51) seasonal hindcasts and forecasts, the <strong>first 25 members</strong> in every year
          (the 2027 policy), initialized in January, February, May or September; monthly totals summed over the target months, on the 0.25° CHIRPS
          grid (the model’s own resolution is about 1°).</td></tr>
        <tr><th scope="row">Observations (the target)</th><td>CHIRPS v3.0 rainfall total of the target month or season, divided by the cell’s CHIRPS
          mean over the training years, so one network serves wet and dry cells alike.</td></tr>
        <tr><th scope="row">Years</th><td>Training {years(TRAIN)}, scored by leave-one-year-out (each year predicted by a network fitted without it);
          test years {years(TEST)}, predicted by a network fitted on {years(TRAIN)}.</td></tr>
        <tr><th scope="row">Samples</th><td>One sample per grid cell and training year: up to about {fmt(CELLS.max)} cells with rainfall
          (at least 1 mm on average; {fmt(CELLS.min)} in the driest target) × {TRAIN[1] - TRAIN[0]} years in each fold. The network trains on every second
          cell in each direction (about a quarter of them) and about 80% of those years; the other years stop the training.</td></tr>
        <tr><th scope="row">Weights</th><td>Each cell by its area (cos latitude); every year the same total weight.</td></tr>
      </tbody>
    </table></div>
    <div class="table-wrap"><table class="compact nosort drn-table">
      <caption>The 10 inputs of each cell and year, standardized with the training samples of the fold before entering the network</caption>
      <thead><tr><th scope="col">Group</th><th scope="col">Input</th><th scope="col">Definition</th></tr></thead>
      <tbody>
        {INPUT_ROWS.map(([grp, name, def], i) => <tr><td>{i === 0 || INPUT_ROWS[i - 1][0] !== grp ? <strong>{grp}</strong> : ''}</td><td>{name}</td><td>{def}</td></tr>)}
      </tbody>
    </table></div>

    <h2 id="training">Training</h2>
    <ol class="findings">
      <li><strong>Network:</strong> one hidden layer of 32 ELU units, or two (32 and 16), then three outputs, turned into the mean
        <code>μ = softplus(o₁)</code>, the spread <code>σ = softplus(o₂)</code> and the shift <code>δ = −softplus(o₃)</code> of a censored
        shifted gamma, as in EMOS. {fmt(PARAMS[0])} trainable parameters with one hidden layer, {fmt(PARAMS[1])} with two; the output starts at
        the training climatology.</li>
      <li><strong>Loss:</strong> the closed-form CRPS of the censored shifted gamma (Scheuerer &amp; Hamill 2015), area-weighted with equal
        weight per year, plus weight decay. The gradient is computed exactly through the network; the CRPS’s own derivatives by finite
        differences.</li>
      <li><strong>Optimizer and stopping:</strong> Adam (learning rate 0.003, full batch, at most 2,000 steps). Every 10 steps the CRPS of
        the held-out years (about 20% of the training years) is checked; training stops after 15 checks without improvement and keeps the best
        network.</li>
      <li><strong>Choice inside each fold:</strong> {SEARCHED.length ? <>of the options evaluated in the results shown ({UNITS.join(' or ')} units;
        weight decay {DECAYS.join(' or ')}),</> : 'the architecture and weight decay'} the one with the lowest held-out CRPS, averaged over three seeds
        that each hold out different years; the forecast is the equal mixture of the three seeds.</li>
      <li><strong>Evaluation:</strong> outer leave-one-year-out over the training years, then the test years; one-sided paired sign-flip test
        over whole years, Benjamini–Hochberg across the targets of a cycle.</li>
    </ol>
    {CHOSEN.length > 0 && (
      <details>
        <summary>The architecture chosen for each target (the network fitted on {years(TRAIN)} that predicts the test years)</summary>
        <div class="table-wrap"><table class="compact">
          <thead><tr><th scope="col">Cycle</th><th scope="col">Target</th><th scope="col">Hidden units</th><th scope="col">Weight decay</th><th scope="col">Training steps of the 3 seeds</th><th scope="col">Held-out CRPS of each option</th></tr></thead>
          <tbody>{CHOSEN.map((r) => <tr><td>{r.cycle}</td><td>{r.target}</td><td>{r.hidden}</td><td>{r.decay}</td><td>{r.steps}</td><td class="caveat">{r.options}</td></tr>)}</tbody>
        </table></div>
        <p class="caveat">Held-out CRPS is in relative units (rainfall ÷ the cell’s mean); lower is better. Early stopping usually ends training
        after tens to a few hundred steps: the predictable signal is small, and longer training would fit noise.</p>
      </details>
    )}

    <h2 id="outputs">Outputs</h2>
    <div class="table-wrap"><table class="compact nosort drn-table">
      <caption>What the network produces for each cell, from the mixture distribution F of the three seeds</caption>
      <thead><tr><th scope="col">Output</th><th scope="col">How it is obtained</th><th scope="col">Scored by</th></tr></thead>
      <tbody>
        <tr><td><strong>Full rainfall distribution</strong></td><td>F(y): a chance of no rain at zero and a gamma-shaped density above it, in mm (relative units × the cell’s CHIRPS mean)</td><td>CRPS and CRPSS, against the MVS-corrected ensemble</td></tr>
        <tr><td><strong>Tercile probabilities</strong></td><td>below F(q₁), near F(q₂) − F(q₁), above 1 − F(q₂), at the cell’s CHIRPS training terciles q₁ and q₂</td><td>RPS, RPSS and Brier skill, against the published probabilities; reliability</td></tr>
        <tr><td><strong>Rainfall amount</strong></td><td>the median F⁻¹(0.5)</td><td>pinball loss</td></tr>
        <tr><td><strong>10–90% range</strong></td><td>F⁻¹(0.1) to F⁻¹(0.9)</td><td>coverage (80% is calibrated) and width</td></tr>
        <tr><td><strong>Chance of no rain</strong></td><td>F(0)</td><td>part of the CRPS</td></tr>
      </tbody>
    </table></div>
    <p>{SHADOW.length
      ? <>Where the method selection lists the DRN as a candidate ({SHADOW.join('; ')}), a <strong>shadow forecast</strong> is made each season next to the
        published one: the median and 10–90% range, frozen before the season and scored when CHIRPS arrives. It is never published as a forecast.</>
      : <>The DRN is not a selection candidate for any target, so no shadow forecast is made.</>}</p>

    <h2 id="experiment">Which experiment these results come from</h2>
    <div class="table-wrap"><table class="compact nosort drn-table exp-panel">
      <tbody>
        <tr><th scope="row">Displayed experiment</th><td>{EXP.length ? EXP.map((e) => <code>{e}</code>) : 'none accepted'}{shown[0]?.a?.note ? ` — ${shown[0].a.note}` : ''}</td></tr>
        <tr><th scope="row">Completed</th><td>{created.length ? created[0].slice(0, 16).replace('T', ' ') + (created.at(-1).slice(0, 16) !== created[0].slice(0, 16) ? ` to ${created.at(-1).slice(0, 16).replace('T', ' ')}` : '') + ' UTC' : '—'}{shown[0]?.a?.accepted_utc ? `; accepted for publication ${shown[0].a.accepted_utc.slice(0, 10)}` : ''}</td></tr>
        <tr><th scope="row">Result source</th><td>{commits.map((c) => <a href={`${REPO}/tree/${c}`}><code>{c.slice(0, 7)}</code></a>)} (the code that produced the results, not the website build) ·
          configuration <code>{(shown[0]?.a?.config ?? '—').replace(/(jan_fmam|feb_fmam|may_jjas|sep_ondj)/, '<cycle>')}</code></td></tr>
        <tr><th scope="row">Data policy</th><td>CHIRPS v3.0 observations; training {years(TRAIN)}, test {years(TEST)}; the first {shown[0]?.a?.members ?? 25} SEAS5 members every year</td></tr>
        <tr><th scope="row">Search evaluated</th><td>{SEARCHED.length ? SEARCHED.map(([h, v]) => `${JSON.parse(h).join(' + ')} units, decay ${decayText(v)}`).join(' · ') : '—'}</td></tr>
        <tr><th scope="row">Scientific status</th><td>Research comparison; the published forecasts do not use it.{SHADOW.length ? ` Selection candidate for ${SHADOW.join('; ')}: needs three independent validation seasons before it can be recommended.` : ' Not a selection candidate.'}</td></tr>
        <tr><th scope="row">Pending</th><td>{PENDING.length || NOT_RUN.length ? <>
          {PENDING.length > 0 && <>Newer runs not yet published ({PENDING.map((r) => `${CYCLE_NAME[r.cycle]} ${r.pending.created_utc.slice(0, 10)}`).join(', ')}); they are published together once all four cycles are complete. </>}
          {NOT_RUN.length > 0 && <>Still to come (running or queued): {NOT_RUN.map((f) => FAMILY[f]).join(', ')}.</>}</> : 'nothing'}</td></tr>
      </tbody>
    </table></div>
    <p class="caveat">Results are published only after a whole batch passes the completeness checks (five targets per cycle, years, members,
    models, clean-commit provenance; <code>scripts/accept_results.py</code>), so the page never mixes experiments.</p>

    {cycles.length > 1 && (
      <div class="seg cycle-pick" role="group" aria-label="Show results for">
        <button type="button" data-cyc="all" aria-pressed="true">All cycles</button>
        {cycles.map(({ name }) => <button type="button" data-cyc={name} aria-pressed="false">{CYCLE_NAME[name] ?? name}</button>)}
      </div>
    )}
    {cycles.length > 0 && (
      <div class="pick-row">
        <div class="seg prod-pick" role="group" aria-label="Product">
          <button type="button" data-prod-pick="all" aria-pressed="true">Both products</button>
          <button type="button" data-prod-pick="crps" aria-pressed="false">Rainfall amounts</button>
          <button type="button" data-prod-pick="rps" aria-pressed="false">Tercile probabilities</button>
        </div>
        {COMPARATORS.length > 1 && (
          <label class="cmp-pick">Comparisons against
            <select>
              <option value="all">every model</option>
              {COMPARATORS.map((k) => <option value={k}>{SHORT[k] ?? k}</option>)}
            </select>
          </label>
        )}
      </div>
    )}
    {cycles.length === 0 && <p class="notice">The benchmark has not been run yet.</p>}
    {cycles.map(({ name, d, x, p, u, p2, all, st, title }) => (
      <section id={name} class="cyc-sec">
        <h2>{title}</h2>
        <p><strong>DRN confirmed better than the published approach under the selection rule (Benjamini–Hochberg):</strong> {confirmedList(d, 'bh').join('; ') || 'none'}.
        In the benchmark as run (Holm): {confirmedList(d, 'holm').join('; ') || 'none'}. Architecture chosen (fit on all training years): {chosen(d)}.</p>
        <div data-prod="crps"><h3>Rainfall amounts (CRPS skill)</h3>
        <Table {...skillTable(d, 'crps')} /></div>
        <div data-prod="rps"><h3>Tercile probabilities (RPS skill)</h3>
        <Table {...skillTable(d, 'rps')} /></div>
        <h3>The tests</h3>
        <div data-prod="crps"><Table {...testTable(d, 'crps')} /></div>
        <div data-prod="rps"><Table {...testTable(d, 'rps')} /></div>
        <h3>Ranges: coverage and width</h3>
        <Table {...coverageTable(d)} />
        <h3>Below- and above-normal probabilities</h3>
        <Table {...brierTable(d)} />
        {d.assets.includes(`assets/neural/${name}/reliability_training.png`) && <Figure src={`assets/neural/${name}/reliability_training.png`} caption="Reliability of the below- and above-normal probabilities, leave-one-year-out over the training years: observed frequency against forecast probability; on the diagonal = reliable." />}
        {Object.keys(d.regions).filter((r) => r !== d.primary_region).map((r) => (
          <>
            <h3>{d.regions[r]}</h3>
            <Table {...domainTable(d, r)} />
          </>
        ))}
        <h3>What the DRN adds (paired, no adjustment)</h3>
        <div data-prod="crps"><Table {...comparisonTable(d, 'crps')} /></div>
        <div data-prod="rps"><Table {...comparisonTable(d, 'rps')} /></div>
        <p class="caveat">Negative Δ favours the DRN. Against EMOS: the value of the network over the linear model; against the linear control:
        the value of the hidden layers; against the ablation: the value of the forecast itself.</p>
        {d.assets.includes(`assets/neural/${name}/distribution_summary.png`) && <Figure src={`assets/neural/${name}/distribution_summary.png`} caption="Skill of every model and target; * the DRN confirmed better than the reference (Holm, as run)." />}
        <p class="caveat">Download: {d.downloads.map((f) => <a href={link(f)}>benchmark.json</a>)} (with the fitted network weights).</p>
        {x && (
          <>
            <h3 id={`${name}-second`}>Second stage: SST inputs, a neural correction of EMOS, controls</h3>
            <p><strong>Confirmed better than the published approach under the selection rule (Benjamini–Hochberg):</strong> {confirmedList(x, 'bh').join('; ') || 'none'}.
            In the benchmark as run (Holm): {confirmedList(x, 'holm').join('; ') || 'none'}. Candidates: the DRN with SST indices and rainfall regions, and the
            neural correction of EMOS (two candidates per target and score). Controls in the same folds and with the same scoring rule
            (corrected CRPS): the DRN with the regions but no SST (so DRN + SST against it is the value of the SST indices alone), the DRN,
            EMOS and quantile regression refitted, and the forecast-only ablation.</p>
            <div data-prod="crps"><Table {...testTable(x, 'crps', 'drn_sst')} /></div>
            <div data-prod="crps"><Table {...testTable(x, 'crps', 'drn_emos_residual')} /></div>
            <div data-prod="rps"><Table {...testTable(x, 'rps', 'drn_sst')} /></div>
            <div data-prod="rps"><Table {...testTable(x, 'rps', 'drn_emos_residual')} /></div>
            <div data-prod="crps"><Table {...comparisonTable(x, 'crps')} /></div>
            <div data-prod="rps"><Table {...comparisonTable(x, 'rps')} /></div>
            <Table {...coverageTable(x)} />
            <p class="caveat">Download: {x.downloads.map((f) => <a href={link(f)}>benchmark.json</a>)}.</p>
          </>
        )}
        {p && (
          <>
            <h3 id={`${name}-pooled`}>One network for the four months</h3>
            <p><strong>Confirmed better under the selection rule (Benjamini–Hochberg):</strong> {confirmedList(p, 'bh').join('; ') || 'none'}.
            In the benchmark as run (Holm): {confirmedList(p, 'holm').join('; ') || 'none'}. One network fitted to the samples of the four
            months together, with the month's position as an input; the season is not pooled.</p>
            <div data-prod="crps"><Table {...testTable(p, 'crps', 'drn_pooled')} /></div>
            <div data-prod="rps"><Table {...testTable(p, 'rps', 'drn_pooled')} /></div>
            <div data-prod="crps"><Table {...comparisonTable(p, 'crps')} /></div>
            <Table {...coverageTable(p)} />
          </>
        )}
        {u && (
          <>
            <h3 id={`${name}-tuning`}>A separate tuning split (diagnostic)</h3>
            <p>The DRN with its architecture and weight decay chosen on three inner folds of years, apart from the years that stop the
            training. Not a candidate: the comparison with the DRN shows whether the tuning procedure matters.</p>
            <div data-prod="crps"><Table {...comparisonTable(u, 'crps')} /></div>
            <div data-prod="rps"><Table {...comparisonTable(u, 'rps')} /></div>
          </>
        )}
        {p2 && (
          <>
            <h3 id={`${name}-pooled2`}>Pooled network: neural correction of EMOS and neighbourhood inputs</h3>
            <p><strong>Confirmed better under the selection rule (Benjamini–Hochberg):</strong> {confirmedList(p2, 'bh').join('; ') || 'none'}.
            In the benchmark as run (Holm): {confirmedList(p2, 'holm').join('; ') || 'none'}. Two candidates on the pooled network of the four months:
            the network correcting an EMOS model fitted for each month, and the network with the means of the ensemble mean, spread and median over
            the 3×3 and 5×5 cells around each cell. The pooled DRN is refitted in the same folds as the control.</p>
            <div data-prod="crps"><Table {...testTable(p2, 'crps', 'drn_pooled_residual')} /></div>
            <div data-prod="crps"><Table {...testTable(p2, 'crps', 'drn_pooled_nbhd')} /></div>
            <div data-prod="rps"><Table {...testTable(p2, 'rps', 'drn_pooled_residual')} /></div>
            <div data-prod="rps"><Table {...testTable(p2, 'rps', 'drn_pooled_nbhd')} /></div>
            <div data-prod="crps"><Table {...comparisonTable(p2, 'crps')} /></div>
            <div data-prod="rps"><Table {...comparisonTable(p2, 'rps')} /></div>
            <Table {...coverageTable(p2)} />
          </>
        )}
        {all && (
          <>
            <h3 id={`${name}-all`}>One network for the months of all four cycles</h3>
            <p><strong>Confirmed better under the selection rule (Benjamini–Hochberg):</strong> {confirmedList(all, 'bh').join('; ') || 'none'}.
            In the benchmark as run (Holm): {confirmedList(all, 'holm').join('; ') || 'none'}. One network fitted to the 16 months of the four
            cycles together, with the month's position and the cycle as inputs; scored here for this cycle's months.</p>
            <div data-prod="crps"><Table {...testTable(all, 'crps', 'drn_pooled_all')} /></div>
            <div data-prod="rps"><Table {...testTable(all, 'rps', 'drn_pooled_all')} /></div>
            <div data-prod="crps"><Table {...comparisonTable(all, 'crps')} /></div>
            <div data-prod="rps"><Table {...comparisonTable(all, 'rps')} /></div>
          </>
        )}
        {st && (
          <>
            <h3 id={`${name}-stack`}>Combination of EMOS, quantile regression and the DRN</h3>
            <p><strong>Confirmed better under the selection rule (Benjamini–Hochberg):</strong> {confirmedList(st, 'bh').join('; ') || 'none'}.
            In the benchmark as run (Holm): {confirmedList(st, 'holm').join('; ') || 'none'}. The equal-weight average of the three models'
            distributions (a linear pool), from their saved predictions in the same folds: the pooled DRN for the months, the DRN for the season.
            Nothing is fitted.</p>
            <div data-prod="crps"><Table {...testTable(st, 'crps', 'stack')} /></div>
            <div data-prod="rps"><Table {...testTable(st, 'rps', 'stack')} /></div>
            <div data-prod="crps"><Table {...comparisonTable(st, 'crps')} /></div>
            <div data-prod="rps"><Table {...comparisonTable(st, 'rps')} /></div>
          </>
        )}
      </section>
    ))}
    <p class="caveat">Code: <a href={`${REPO}/blob/main/scripts/neural_calibration.py`}><code>scripts/neural_calibration.py</code></a> · write-up: <a href={`${REPO}/blob/main/docs/54_NEURAL_DISTRIBUTIONAL_REGRESSION.md`}>docs/54</a>.</p>
  </OnThisPage>
<script>
  // Cycle selector: one cycle's results at a time (or all); the choice is kept in the address (#cycle)
  const pick = document.querySelector('.cycle-pick');
  if (pick) {
    const show = (c: string) => {
      document.querySelectorAll<HTMLElement>('.cyc-sec').forEach((s) => { s.hidden = c !== 'all' && s.id !== c; });
      pick.querySelectorAll<HTMLElement>('[data-cyc]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cyc === c)));
    };
    pick.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-cyc]');
      if (!b) return;
      show(b.dataset.cyc!);
      history.replaceState(null, '', b.dataset.cyc === 'all' ? location.pathname + location.search : '#' + b.dataset.cyc);
    });
    const h = location.hash.slice(1);
    if (h && document.getElementById(h)?.classList.contains('cyc-sec')) show(h);
  }
  // Product selector: amounts (CRPS) or probabilities (RPS) tables only
  const prod = document.querySelector('.prod-pick');
  prod?.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-prod-pick]');
    if (!b) return;
    const v = b.dataset.prodPick!;
    document.querySelectorAll<HTMLElement>('[data-prod]').forEach((el) => { el.hidden = v !== 'all' && el.dataset.prod !== v; });
    prod.querySelectorAll<HTMLElement>('[data-prod-pick]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  });
  // Comparator selector: the rows of the comparison tables against one model
  document.querySelector<HTMLSelectElement>('.cmp-pick select')?.addEventListener('change', (ev) => {
    const v = (ev.target as HTMLSelectElement).value;
    document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((el) => {
      const tr = el.closest('tr');
      if (tr) tr.hidden = v !== 'all' && el.dataset.cmp !== v;
    });
  });
</script>
<style is:global>
  .pick-row{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;margin:4px 0}
  .prod-pick{flex-wrap:wrap}
  .cmp-pick select{margin-left:6px}
  .cycle-pick{flex-wrap:wrap;margin:10px 0 4px;position:sticky;top:120px;z-index:5;background:var(--bg);padding:4px 0}
  .exp-panel td code{margin-right:6px}
  .drn-fig{margin:10px 0 4px;overflow-x:auto}
  .drn-fig svg{display:block;width:100%;min-width:760px;height:auto}
  .drn-table th[scope=row]{white-space:nowrap;vertical-align:top}
</style>
</Base>
