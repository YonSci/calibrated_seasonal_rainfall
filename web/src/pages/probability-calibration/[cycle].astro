---
import Base from '../../layouts/Base.astro';
import Table from '../../components/Table.astro';
import Figure from '../../components/Figure.astro';
import Downloads from '../../components/Downloads.astro';
import { read, names, href, esc, cycleTitle, REPO } from '../../lib/data.js';
import { phase1, binary, distribution, shadow } from '../../lib/probcal.js';

export function getStaticPaths() {
  return names('probcal').map((cycle) => ({ params: { cycle } }));
}
const { cycle } = Astro.params;
const D = read(`probcal/${cycle}.json`);
const title = cycleTitle(D.initialization_month, D.season);
const P1 = phase1(D.phase1);
const B = binary(D.phase2_binary);
const dists = [distribution(D.phase2_distribution), distribution(D.phase3)].filter(Boolean);
const S = shadow(D.amount_shadow, Object.keys(D.phase1.targets));
const fig = (f) => `${D.figures}/${f}`;
const has = (f) => D.assets.includes(fig(f));
const sub = (phase) => (phase === 2 ? 'distribution' : 'phase3');
const commit = (p) => (p.commit ?? '').slice(0, 7) + (p.uncommitted_changes ? ' (with uncommitted changes)' : '');
const others = names('probcal').filter((n) => n !== cycle);
---
<Base title={`Probability calibration · ${title}`} section="probability-calibration/"
      description={`Probability and rainfall-distribution calibration for the ${title} cycle: every method against the published pipeline.`}>
  <p class="caveat"><a href={href('probability-calibration/')}>Probability calibration</a> › {title}</p>
  <h1>{title}</h1>
  <p class="toc">
    <a href="#phase1">Phase 1</a>{B && <a href="#binary">Phase 2 · binary</a>}{dists.map((x) => <a href={`#dist${x.phase}`}>Phase {x.phase} · distributions</a>)}
    {S.length > 0 && <a href="#shadow">Amount and range shadow</a>}<a href="#downloads">Downloads</a>
  </p>

  <section id="phase1">
    <h2>Phase 1 · tercile probability methods</h2>
    <p><strong>Confirmed better than the incumbent climatology blend for the published tercile probabilities (RPS): {P1.confirmed}.</strong>
    ✓ = better than the incumbent with Holm-adjusted p &lt; 0.05 across every method and target (SEL: across the targets) and not worse
    over {P1.te}. Amount correction fixed: {String(P1.amount).toUpperCase()}. National aggregate ({P1.region}). Run at commit <code>{commit(P1.provenance)}</code>.</p>
    <Table {...P1.rpss} />
    <Table {...P1.test} />
    <details><summary>Log loss, Brier skill, tests, fitted parameters and the selection</summary>
      <Table {...P1.logloss} /><Table {...P1.below} /><Table {...P1.above} /><Table {...P1.tests} /><Table {...P1.fits} />
    </details>
    {has('probability_summary.png') && <Figure src={fig('probability_summary.png')} caption="RPSS and log-loss skill by method and target." />}
    {has('probability_reliability.png') && <Figure src={fig('probability_reliability.png')} caption="Reliability of each method for the season (below and above normal)." />}
  </section>

  {B && (
    <section id="binary">
      <h2>Phase 2 · binary calibrators (one-vs-rest, normalized)</h2>
      <p>Platt, beta and isotonic calibration of each category against the rest, divided by their sum inside the pipeline, against the
      incumbent (their own family: Holm across these methods and the targets). <strong>Confirmed better: {B.confirmed}.</strong></p>
      <Table {...B.training} />
      <details><summary>Test years</summary><Table {...B.test} /></details>
    </section>
  )}

  {dists.map((x) => (
    <section id={`dist${x.phase}`}>
      <h2>Phase {x.phase} · rainfall-distribution models (Pathway B)</h2>
      <p>Each model predicts a full rainfall distribution from the raw ensemble (pooled over cells in units relative to each cell's
      climatology); terciles at the training CHIRPS boundaries, quantiles and intervals come from it. References, in the same folds:
      the published probabilities (tercile RPS) and the MVS-corrected ensemble (CRPS, quantiles). ✓ = better than the reference with
      Holm-adjusted p &lt; 0.05 across the models and targets, and not worse over {x.te}. <strong>Confirmed better — tercile probabilities:
      {x.foundRps}; rainfall amounts (CRPS): {x.foundCrps}.</strong></p>
      <Table {...x.rps} />
      <Table {...x.crps} />
      <details><summary>Interval coverage, median pinball loss, test years, fit diagnostics and the model definitions</summary>
        <Table {...x.coverage} /><Table {...x.pinball} /><Table {...x.test} />
        <ul class="findings">{x.diagnostics.map((g) => <li>{g.name}: {g.converged ? 'converged in every fold' : 'did not converge in every fold'}{g.crossing !== null && `; quantile rearrangement needed for at most ${(100 * g.crossing).toFixed(1)}% of cells`}.</li>)}</ul>
        <Table {...x.models} />
      </details>
      {has(`${sub(x.phase)}/distribution_summary.png`) && <Figure src={fig(`${sub(x.phase)}/distribution_summary.png`)}
        caption={`Tercile RPSS and amount CRPSS of the Phase ${x.phase} distribution models against the published pipeline.`} />}
    </section>
  ))}

  {S.length > 0 && (
    <section id="shadow">
      <h2>Shadow forecast · rainfall amounts and ranges (EMOS), not published</h2>
      <p class="notice"><strong>Not a published forecast.</strong> Since {D.shadow_config.since}, each cycle also runs the EMOS distribution model
      (censored shifted gamma, fitted on the cycle's reference years) and records its median and 10–90% range for every target next to the
      MVS-corrected ensemble. {D.shadow_config.reason} Each season is scored once its CHIRPS observations exist; any change to what is
      published is a separate decision after several seasons.</p>
      {S.map((y) => (
        <>
          <h3>{y.year} forecast · {y.observed.length} of {y.targets.length} targets observed so far</h3>
          <Table {...y.forecast} />
          {y.scores ? <Table {...y.scores} /> : <p class="caveat">Awaiting CHIRPS observations.</p>}
          {y.targets.map((t) => (
            <details><summary>{t} {y.year}: maps</summary>
              <Figure src={`assets/probcal/${cycle}/amount_shadow/${y.year}/shadow_${y.model}_${y.year}_${t}.png`} caption={`Shadow amounts and ranges, ${t} ${y.year}.`} />
            </details>
          ))}
          <p class="caveat">Run at commit <code>{commit(y.provenance)}</code>.</p>
        </>
      ))}
    </section>
  )}

  <section id="downloads">
    <h2>Downloads</h2>
    <Downloads prefix={`downloads/probcal/${cycle}/`}
      extra={[[`${REPO}/blob/main/docs/48_PROBABILITY_CALIBRATION.md`, 'Full write-up (docs/48)', 'Methods, design, all result tables and the references']]} />
  </section>
  <p class="caveat">Other cycles: {others.map((n, i) => <>{i > 0 && ' · '}<a href={href(`probability-calibration/${n}/`)}>{n}</a></>)}</p>
</Base>
